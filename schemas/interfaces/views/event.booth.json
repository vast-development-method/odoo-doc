   "declaration": "<field name=\"arch\" type=\"xml\">\n            <div name=\"button_box\" position=\"inside\">\n                <button name=\"action_view_sale_order\" type=\"object\" class=\"oe_stat_button\" icon=\"fa-usd\" groups=\"sales_team.group_sale_salesman\" invisible=\"not sale_order_id\">\n                        <div class=\"o_stat_info\">\n                            <span class=\"o_stat_text\">Sale Order</span>\n                        </div>\n                </button>\n                <field name=\"sale_order_id\" invisible=\"1\"/>\n            </div>\n            <div name=\"button_box\" position=\"after\">\n                <field name=\"is_paid\" invisible=\"1\"/>\n                <widget name=\"web_ribbon\" title=\"Paid\" invisible=\"not is_paid\"/>\n            </div>\n            <field name=\"booth_category_id\" position=\"after\">\n                <field name=\"currency_id\" invisible=\"1\"/>\n                <field name=\"product_id\" invisible=\"not booth_category_id\"/>\n                <field name=\"price\" widget=\"monetary\" options=\"{'currency_field': 'currency_id'}\" invisible=\"not booth_category_id\"/>\n            </field>\n            <group name=\"renter\" position=\"after\">\n                <group name=\"sales\" groups=\"sales_team.group_sale_salesman\" invisible=\"not sale_order_line_id\">\n                    <field name=\"sale_order_id\" groups=\"base.group_no_one\"/>\n                    <field name=\"sale_order_line_id\" groups=\"base.group_no_one\" readonly=\"state != 'available'\"/>\n                </group>\n            </group>\n            <xpath expr=\"//sheet\" position=\"inside\">\n                <notebook groups=\"base.group_no_one\">\n                    <page string=\"Registrations\" name=\"page_registrations\">\n                        <field name=\"event_booth_registration_ids\" readonly=\"1\"/>\n                    </page>\n                </notebook>\n            </xpath>\n        </field>\n    "
