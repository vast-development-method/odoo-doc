   "declaration": "<field name=\"arch\" type=\"xml\">\n            <kanban class=\"o_kanban_mobile o_kanban_mailing_list\" sample=\"1\">\n                <field name=\"active\"/>\n                <templates>\n                    <t t-name=\"card\">\n                        <div class=\"d-flex gap-1 flex-row justify-content-between align-items-center flex-wrap\">\n                            <div class=\"col-lg-3 col-sm-6 col-12 py-0 my-auto\">\n                                <span class=\"d-inline-block w-100 text-truncate fs-2 fw-normal lh-sm\" t-att-title=\"record.name.value\">\n                                    <field name=\"name\"/>\n                                </span>\n                            </div>\n                            <div class=\"col-lg-1 col-6 my-auto d-flex\">\n                                <div class=\"d-flex flex-row justify-content-start justify-content-md-end\">\n                                    <button name=\"action_view_contacts\" type=\"object\" class=\"o_mailing_list_kanban_button o_mailing_list_kanban_big_nb text-primary fw-bold\">\n                                        <field name=\"contact_count\"/>\n                                    </button>\n                                    <button name=\"action_view_contacts\" type=\"object\" class=\"o_mailing_list_kanban_button fs-4 lh-1 text-start ms-2\">\n                                        Total <br/>Contacts\n                                    </button>\n                                </div>\n                            </div>\n                            <div class=\"o_mailing_list_kanban_stats order-4 order-lg-3 col-lg-5 col-sm-12 col-12 py-0 my-3 my-sm-auto d-flex justify-content-sm-between justify-content-start flex-wrap\">\n                                <a class=\"me-sm-0 me-3 fs-4 fw-light lh-1 text-truncate\" tabindex=\"-1\" name=\"action_view_contacts_email\" type=\"object\">\n                                    <field name=\"contact_count_email\" class=\"fw-normal\"/>\n                                    <br/>\n                                    <span class=\"text-muted\">\n                                        <i class=\"fa fa-envelope-o\"/> Contacts\n                                    </span>\n                                </a>\n                                <a class=\"me-sm-0 me-3 fs-4 fw-light lh-1 text-truncate\" tabindex=\"-1\" name=\"action_view_mailings\" type=\"object\">\n                                    <field name=\"mailing_count\" class=\"fw-normal\"/>\n                                    <br/>\n                                    <span class=\"text-muted\">Mailings</span>\n                                </a>\n                                <hr class=\"w-100 d-block d-sm-none opacity-0 m-0 p-0\"/>\n                                <a class=\"me-sm-0 me-3 fs-4 fw-light lh-1 text-truncate\" tabindex=\"-1\" name=\"action_view_contacts_bouncing\" type=\"object\">\n                                    <span class=\"fw-normal\">\n                                        <field name=\"contact_pct_bounce\"/> %\n                                    </span>\n                                    <br/>\n                                    <span class=\"text-muted\">Bounce</span>\n                                </a>\n                                <a class=\"me-sm-0 me-3 fs-4 fw-light lh-1 text-truncate\" tabindex=\"-1\" name=\"action_view_contacts_opt_out\" type=\"object\">\n                                    <span class=\"fw-normal\">\n                                        <field name=\"contact_pct_opt_out\"/> %\n                                    </span>\n                                    <br/>\n                                    <span class=\"text-muted\">Opt-Out</span>\n                                </a>\n                                <a class=\"me-sm-0 me-3 fs-4 fw-light lh-1 text-truncate\" tabindex=\"-1\" name=\"action_view_contacts_blacklisted\" type=\"object\">\n                                    <span class=\"fw-normal\">\n                                        <field name=\"contact_pct_blacklisted\"/> %\n                                    </span>\n                                    <br/>\n                                    <span class=\"text-muted\">Blacklist</span>\n                                </a>\n                            </div>\n                            <div class=\"order-3 order-lg-4 col-5 col-lg-2 py-0 my-auto d-none d-md-flex flex-wrap justify-content-end gap-1\">\n                                <button name=\"action_open_import\" string=\"Import Contacts\" type=\"object\" class=\"btn btn-secondary text-nowrap\">\n                                    Import Contacts\n                                </button>\n                                <button name=\"action_send_mailing\" string=\"Send Mailing\" type=\"object\" class=\"btn btn-secondary text-nowrap\">\n                                    Send Mailing\n                                </button>\n                            </div>\n                        </div>\n                    </t>\n                </templates>\n            </kanban>\n        </field>\n    "
