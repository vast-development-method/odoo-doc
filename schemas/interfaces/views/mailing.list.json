   "declaration": "<field name=\"arch\" type=\"xml\">\n            <form string=\"Contact List\">\n                <header>\n                    <button name=\"action_send_mailing\" string=\"Send Mailing\" type=\"object\" class=\"btn btn-primary\"/>\n                    <button name=\"action_open_import\" string=\"Import Contacts\" type=\"object\" class=\"btn btn-secondary\"/>\n                </header>\n                <sheet>\n                    <div class=\"oe_button_box\" name=\"button_box\">\n                        <button name=\"action_view_contacts\" type=\"object\" icon=\"fa-user\" class=\"oe_stat_button\">\n                            <field name=\"contact_count\" string=\"Recipients\" widget=\"statinfo\"/>\n                        </button>\n                        <button name=\"action_view_mailings\" type=\"object\" icon=\"fa-envelope-o\" class=\"oe_stat_button\">\n                            <field name=\"mailing_count\" string=\"Mailings\" widget=\"statinfo\"/>\n                        </button>\n                        <button name=\"action_view_contacts_bouncing\" type=\"object\" icon=\"fa-exchange\" class=\"oe_stat_button\">\n                                <field name=\"contact_pct_bounce\" widget=\"statinfo\" string=\"% Bounce\"/>\n                        </button>\n                        <button name=\"action_view_contacts_opt_out\" type=\"object\" icon=\"fa-bell-slash-o\" class=\"oe_stat_button\">\n                                <field name=\"contact_pct_opt_out\" widget=\"statinfo\" string=\"% Opt-out\"/>\n                        </button>\n                        <button name=\"action_view_contacts_blacklisted\" type=\"object\" icon=\"fa-ban\" class=\"oe_stat_button\">\n                                <field name=\"contact_pct_blacklisted\" widget=\"statinfo\" string=\"% Blacklist\"/>\n                        </button>\n                    </div>\n                    <widget name=\"web_ribbon\" title=\"Archived\" bg_color=\"text-bg-danger\