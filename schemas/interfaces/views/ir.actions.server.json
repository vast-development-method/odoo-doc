  {
   "external_identifier": "mail.view_server_action_form_template",
   "package": "mail",
   "name": "ir.actions.server.form",
   "entity": "ir.actions.server",
   "view_type": "xpath",
   "inherits_view": "base.view_server_action_form",
   "mode": null,
   "priority": null,
   "groups": null,
   "active": null,
   "structure": {
    "root": "xpath",
    "root_attributes": {
     "expr": "//form",
     "position": "inside"
    },
    "fields": [],
