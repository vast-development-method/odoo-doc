   "declaration": "<field name=\"arch\" type=\"xml\">\n            <form string=\"Activities\">\n                <sheet>\n                    <widget name=\"web_ribbon\" title=\"Archived\" bg_color=\"text-bg-danger\" invisible=\"active\"/>\n                    <div class=\"oe_title\">\n                        <label for=\"name\" class=\"oe_edit_only\"/>\n                        <h1><field name=\"name\" placeholder=\"e.g. Schedule a meeting\" options=\"{'line_breaks': False}\" widget=\"text\"/></h1>\n                    </div>\n                    <group>\n                        <group name=\"activity_details\" string=\"Activity Settings\">\n                            <field name=\"active\" invisible=\"1\"/>\n                            <field name=\"category\"/>\n                            <field name=\"default_user_id\" options=\"{'no_create': True}\" domain=\"[('share', '=', False)]\" widget=\"many2one_avatar_user\"/>\n                            <field name=\"res_model\" invisible=\"context.get('default_res_model')\" placeholder=\"Available everywhere\"/>\n                            <field name=\"summary\" placeholder=\"e.g. &quot;Discuss proposal&quot;\"/>\n                            <field name=\"icon\" groups=\"base.group_no_one\"/>\n                            <field name=\"decoration_type\" groups=\"base.group_no_one\"/>\n                            <label for=\"delay_count\"/>\n                            <div>\n                                <field class=\"oe_inline pe-1 o_input_3ch\" name=\"delay_count\"/>\n                                <field class=\"oe_inline ps-1 pe-2\" name=\"delay_unit\"/>\n                                <field class=\"oe_inline\" name=\"delay_from\"/>\n                            </div>\n                        </group>\n                        <group name=\"activity_planning\" string=\"Next Activity\">\n                            <field name=\"chaining_type\" invisible=\"category == 'upload_file'\"/>\n                            <field name=\"triggered_next_type_id\" options=\"{'no_open': True}\" context=\"{'default_res_model': res_model}\" invisible=\"chaining_type == 'suggest' and category != 'upload_file'\" required=\"chaining_type == 'trigger' and category != 'upload_file'\"/>\n                            <field name=\"suggested_next_type_ids\" widget=\"many2many_tags\" context=\"{'default_res_model': res_model}\" invisible=\"chaining_type == 'trigger' or category == 'upload_file'\"/>\n                            <field name=\"mail_template_ids\" widget=\"many2many_tags\" domain=\"[('model_id.model', '=', res_model)]\" invisible=\"not res_model\" context=\"{'default_model': res_model}\"/>\n                        </group>\n                    </group>\n                    <label for=\"default_note\" class=\"fw-bold\"/>\n                    <field nolabel=\"1\" name=\"default_note\" placeholder=\"e.g. &quot;Go over the offer and discuss details&quot;\" class=\"oe-bordered-editor\"/>\n                </sheet>\n            </form>\n        </field>\n    "
