relativedelta(days=7)).strftime('%Y-%m-%d')\">\n                                <field name=\"skill_type_id\" optional=\"hidden\"/>\n                                <field name=\"skill_id\"/>\n                                <field name=\"skill_level_id\"/>\n                                <field name=\"level_progress\" widget=\"progressbar\"/>\n                                <field name=\"valid_to\" column_invisible=\"1\"/>\n                            </list>\n                        </field>\n                    </div>\n                </div>\n            </page>\n            <page name=\"resume\" position=\"after\">\n                <page name=\"certification\" string=\"Certifications\">\n                    <field name=\"certification_ids\" mode=\"list\" nolabel=\"1\" readonly=\"1\">\n                        <list no_open=\"1\" decoration-muted=\"valid_to and valid_to &lt; context_today().strftime('%Y-%m-%d')\">\n                            <field name=\"skill_id\" width=\"300\" string=\"Certification\"/>\n                            <field name=\"valid_from\" string=\"From\" widget=\"formatted_date\" options=\"{                                 'month_format': 'short',                             }\"/>\n                            <field name=\"valid_to\" string=\"To\" widget=\"formatted_date\" options=\"{                                 'month_format': 'short',                                 'color': {                                     'danger': 'valid_to and valid_to &lt;= (context_today() + relativedelta(days=7)).strftime(\\'%Y-%m-%d\\') and valid_to &gt; context_today().strftime(\\'%Y-%m-%d\\')',                                     'warning': 'valid_to and valid_to &lt;= (context_today() + relativedelta(months=3)).strftime(\\'%Y-%m-%d\\') and valid_to &gt; (context_today() + relativedelta(days=7)).strftime(\\'%Y-%m-%d\\')'                                 }                             }\"/>\n                        </list>\n                    </field>\n                </page>\n            </page>\n        </field>\n    "
