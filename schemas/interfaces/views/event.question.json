   "declaration": "<field name=\"arch\" type=\"xml\">\n            <form string=\"Question\">\n                <sheet>\n                    <div class=\"oe_button_box\" name=\"button_box\">\n                        <button name=\"action_view_question_answers\" type=\"object\" class=\"oe_stat_button\" icon=\"fa-line-chart\" invisible=\"question_type not in ['simple_choice', 'text_box']\">\n                            <div class=\"o_stat_info\">\n                                <span class=\"o_stat_text\">\n                                    Attendee answers\n                                </span>\n                            </div>\n                        </button>\n                    </div>\n                    <div class=\"alert alert-warning\" role=\"alert\" invisible=\"event_count == 0\">\n                        This question is used by\n                        <button class=\"oe_link p-0 align-baseline\" type=\"object\" name=\"action_event_view\">\n                            <field name=\"event_count\"/>\n                            events\n                        </button>.\n                    </div>\n                    <h1 class=\"d-flex\"><field name=\"title\" placeholder=\"e.g. &quot;Do you have any diet restrictions?&quot;\" class=\"flex-grow-1\"/></h1>\n                    <group>\n                        <group>\n                            <field name=\"is_mandatory_answer\"/>\n                            <field name=\"question_type\" widget=\"radio\"/>\n                        </group>\n                        <group>\n                            <field name=\"once_per_order\"/>\n                            <field name=\"is_default\"/>\n                            <field name=\"event_type_ids\" invisible=\"1\"/>\n                            <field name=\"is_reusable\" readonly=\"is_default\"/>\n                        </group>\n                    </group>\n                    <notebook invisible=\"question_type != 'simple_choice'\">\n          