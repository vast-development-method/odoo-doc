"Ready\" name=\"ready\" domain=\"[('state', '=', 'confirmed'), ('is_parts_available', '=', True)]\" invisible=\"True\"/>\n                <filter string=\"Late\" name=\"filter_late\" domain=\"[('state', '=', 'confirmed'), ('schedule_date', '&lt;', 'today')]\"/>\n                <filter name=\"filter_create_date\" date=\"create_date\"/>\n                <separator/>\n                <filter invisible=\"1\" string=\"My Activities\" name=\"filter_activities_my\" domain=\"[('activity_user_id', '=', uid)]\"/>\n                <separator invisible=\"1\"/>\n                <filter invisible=\"1\" string=\"Late Activities\" name=\"activities_overdue\" domain=\"[('my_activity_date_deadline', '&lt;', 'today')]\" help=\"Show all records whose next activity date is past\"/>\n                <filter invisible=\"1\" string=\"Today Activities\" name=\"activities_today\" domain=\"[('my_activity_date_deadline', '=', 'today')]\"/>\n                <filter invisible=\"1\" string=\"Future Activities\" name=\"activities_upcoming_all\" domain=\"[('my_activity_date_deadline', '&gt;', 'today')]\"/>\n                <group>\n                    <filter string=\"Customer\" name=\"partner\" domain=\"[]\" context=\"{'group_by': 'partner_id'}\"/>\n                    <filter string=\"Product\" name=\"product\" domain=\"[]\" context=\"{'group_by': 'product_id'}\"/>\n                    <filter string=\"Status\" name=\"status\" domain=\"[]\" context=\"{'group_by': 'state'}\"/>\n                    <filter string=\"Company\" name=\"company\" domain=\"[]\" context=\"{'group_by': 'company_id'}\" groups=\"base.group_multi_company\"/>\n                    <filter string=\"Properties\" name=\"group_by_repair_properties\" context=\"{'group_by': 'repair_properties'}\"/>\n                </group>\n            </search>\n        </field>\n    "
