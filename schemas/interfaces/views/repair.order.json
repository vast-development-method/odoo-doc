      "string": "Sale Order",
      "icon": "fa-dollar",
      "class": "oe_stat_button",
      "invisible": "not sale_order_id"
     },
     {
      "name": "%(action_repair_move_lines)d",
      "type": "action",
      "string": "Product Moves",
      "class": "oe_stat_button",
      "icon": "fa-exchange",
      "invisible": "state not in ['done', 'cancel']"
     }
