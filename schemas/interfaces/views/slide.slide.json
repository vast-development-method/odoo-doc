   "declaration": "<field name=\"arch\" type=\"xml\">\n                <form string=\"Lesson\">\n                    <sheet>\n                        <field name=\"channel_type\" invisible=\"1\" readonly=\"1\"/>\n                        <field name=\"channel_allow_comment\" invisible=\"1\" readonly=\"1\"/>\n                        <div class=\"oe_button_box\" name=\"button_box\">\n                            <button name=\"%(slide_slide_partner_action_from_slide)d\" class=\"oe_stat_button\" type=\"action\" icon=\"fa-graduation-cap\" invisible=\"slide_views == 0\">\n                                <field name=\"slide_views\" widget=\"statinfo\" string=\"Attendees\"/>\n                            </button>\n                            <button disabled=\"1\" icon=\"fa-thumbs-up\" class=\"oe_stat_button\" invisible=\"channel_type == 'training' or likes == 0\">\n                                <field class=\"ms-1\" name=\"likes\" widget=\"statinfo\" string=\"Likes\"/>\n                             </button>\n                             <button disabled=\"1\" icon=\"fa-thumbs-down\" class=\"oe_stat_button\" invisible=\"channel_type == 'training' or dislikes == 0\">\n                                <field class=\"ms-1\" name=\"dislikes\" widget=\"statinfo\" string=\"Dislikes\"/>\n                             </button>\n                             <button disabled=\"1\" icon=\"fa-comments\" class=\"oe_stat_button\" invisible=\"not channel_allow_comment or comments_count == 0\">\n                                <field class=\"ms-1\" name=\"comments_count\" widget=\"statinfo\" string=\"Comments\"/>\n                            </button>\n                            <button name=\"action_view_embeds\" class=\"oe_stat_button\" type=\"object\" icon=\"fa-share-alt\" invisible=\"embed_count == 0\">\n                                <div class=\"o_stat_info\">\n                                    <span class=\"o_stat_value\"><field name=\"embed_count\"/></span>\n                                    <span class=\"o_stat_text\">Embed Views</span>\n                                </div>\n                            </button>\n                            <field name=\"is_published\" widget=\"website_redirect_button\" invisible=\"is_category or not channel_id\"/>\n                        </div>\n                        <widget name=\"web_ribbon\" title=\"Archived\" bg_color=\"text-bg-danger\" invisible=\"active\"/>\n                        <field name=\"image_1920\" widget=\"image\" class=\"oe_avatar\" options=\"{&quot;preview_image&quot;: &quot;image_256&quot;}\" invisible=\"is_category\"/>\n                        <div class=\"oe_title pe-xl-0\">\n                            <div>\n                                <label for=\"name\" string=\"Content Title\"/>\n                            </div>\n                            <h1>\n                                <field name=\"name\" default_focus=\"1\" placeholder=\"e.g. Setting up your computer\" class=\"me-0\"/>\n                                <field name=\"is_category\" invisible=\"1\"/>\n                            </h1>\n                            <field name=\"tag_ids\" invisible=\"is_category\" widget=\"many2many_tags\" placeholder=\"Tags...\"/>\n                        </div>\n                        <notebook invisible=\"is_category\">\n                            <page name=\"document\" string=\"Document\">\n                                <group>\n                                    <group name=\"lesson_details\">\n                                        <field name=\"active\" invisible=\"1\"/>\n                                        <field name=\"channel_id\"/>\n                                        <field name=\"slide_category\" string=\"Content Type\"/>\n                                        <field name=\"slide_type\" invisible=\"1\"/>\n                                        <div class=\"text-muted\" colspan=\"2\" invisible=\"slide_category != 'quiz'\">\n                                            You can add questions to this quiz in the 'Quiz' tab.\n                                        </div>\n                                        <label for=\"source_type\" string=\"\" invisible=\"slide_category not in ['infographic', 'document']\"/>\n                                        <field name=\"source_type\" widget=\"radio\" nolabel=\"1\" invisible=\"slide_category not in ['infographic', 'document']\"/>\n                                        <field name=\"video_url\" invisible=\"slide_category != 'video'\" readonly=\"slide_category != 'video'\" required=\"slide_category == 'video'\" placeholder=\"e.g &quot;www.youtube.com/watch?v=ebBez6bcSEc&quot;\" widget=\"url\"/>\n                                        <field name=\"document_google_url\" invisible=\"source_type != 'external' or slide_category != 'document'\" readonly=\"source_type != 'external' or slide_category != 'document'\" placeholder=\"e.g &quot;https://drive.google.com/file/...&quot;\" widget=\"url\"/>\n                                        <field name=\"image_google_url\" invisible=\"source_type != 'external' or slide_category != 'infographic'\" readonly=\"source_type != 'external' or slide_category != 'infographic'\" placeholder=\"e.g &quot;https://drive.google.com/file/...&quot;\" widget=\"url\"/>\n                                        <field name=\"document_binary_content\" string=\"\" options=\"{'accepted_file_extensions': '.pdf'}\" invisible=\"source_type == 'external' or slide_category != 'document'\" readonly=\"source_type == 'external' or slide_category != 'document'\"/>\n                                        <field name=\"image_binary_content\" string=\"\" options=\"{'accepted_file_extensions': 'image/*'}\" invisible=\"source_type == 'external' or slide_category != 'infographic'\" readonly=\"source_type == 'external' or slide_category != 'infographic'\"/>\n                                    </group>\n                                    <group name=\"related_details\">\n                                        <field name=\"user_id\" string=\"Responsible\" domain=\"[('share', '=', False)]\" widget=\"many2one_avatar\"/>\n                                        <label for=\"completion_time\"/>\n                                        <div>\n                                            <field name=\"completion_time\" widget=\"float_time\" class=\"oe_inline\"/>\n                                            <span> hours</span>\n                                        </div>\n                                        <field name=\"slide_resource_downloadable\" invisible=\"slide_category != 'document' or source_type != 'local_file'\"/>\n                                        <field name=\"date_published\" string=\"Published Date\" invisible=\"not date_published\" groups=\"base.group_no_one\"/>\n                                        <field name=\"is_preview\"/>\n                                        <field name=\"public_views\"/>\n                                        <field name=\"total_views\"/>\n                                    </group>\n                                </group>\n                            </page>\n                            <page name=\"description\" string=\"Description\">\n                                <field name=\"description\" options=\"{'embedded_components': false}\" placeholder=\"e.g. In this video, we'll give you the keys on how the system can help you to grow your business. At the end, we'll propose you a quiz to test your knowledge.\"/>\n                            </page>\n                            <page string=\"Additional Resources\" name=\"external_links\">\n                                <group>\n                                    <field name=\"slide_resource_ids\" widget=\"one2many\" nolabel=\"1\">\n                                        <list editable=\"top\">\n                                            <field name=\"sequence\" widget=\"handle\"/>\n                                            <field name=\"resource_type\"/>\n                                            <field name=\"name\" required=\"1\"/>\n                                            <field name=\"file_name\" column_invisible=\"True\"/>\n                                            <field name=\"data\" readonly=\"resource_type == 'url'\" filename=\"file_name\"/>\n                                            <field name=\"link\" string=\"Link\" readonly=\"resource_type == 'file'\" required=\"resource_type == 'url'\"/>\n                                        </list>\n                                    </field>\n                                </group>\n                            </page>\n                            <page name=\"quiz\" string=\"Quiz\">\n                                <group name=\"quiz_details\">\n                                    <group name=\"quiz_rewards\" string=\"Points Rewards\">\n                                        <group>\n                                            <field string=\"First Try\" name=\"quiz_first_attempt_reward\"/>\n                                            <field string=\"Second Try\" name=\"quiz_second_attempt_reward\"/>\n                                            <field string=\"Third Try\" name=\"quiz_third_attempt_reward\"/>\n                                            <field string=\"Fourth Try &amp; More\" name=\"quiz_fourth_attempt_reward\"/>\n                                        </group>\n                                    </group>\n                                    <group name=\"questions\" string=\"Questions\">\n                                        <field name=\"question_ids\" nolabel=\"1\" colspan=\"2\">\n                                            <list>\n                                                <field name=\"sequence\" widget=\"handle\"/>\n                                                <field name=\"question\" string=\"Question\"/>\n                                                <field name=\"answer_ids\" string=\"Answers\" widget=\"many2many_tags\"/>\n                                            </list>\n                                        </field>\n                                    </group>\n                                </group>\n                            </page>\n                        </notebook>\n                    </sheet>\n                    <chatter/>\n                </form>\n            </field>\n        "
  },
