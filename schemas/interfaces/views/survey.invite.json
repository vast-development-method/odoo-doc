   "declaration": "<field name=\"arch\" type=\"xml\">\n                <form string=\"Compose Email\" class=\"o_mail_composer_form\">\n                    <group col=\"1\">\n                        <group col=\"2\">\n                            <field name=\"author_id\" invisible=\"1\"/>\n                            <field name=\"survey_access_mode\" invisible=\"1\"/>\n                            <field name=\"survey_users_login_required\" invisible=\"1\"/>\n                            <field name=\"survey_users_can_signup\" invisible=\"1\"/>\n                            <field name=\"survey_id\" invisible=\"1\"/>\n                            <field name=\"existing_mode\" widget=\"radio\" invisible=\"1\"/>\n                            <field name=\"lang\" invisible=\"1\"/>\n                            <field name=\"render_model\" invisible=\"1\"/>\n                            <label class=\"o_survey_label_survey_start_url\" for=\"survey_start_url\" string=\"Survey Link\" invisible=\"survey_access_mode != 'public'\"/>\n                            <field name=\"survey_start_url\" nolabel=\"1\" widget=\"CopyClipboardChar\" readonly=\"1\" invisible=\"survey_access_mode != 'public'\"/>\n                            <field string=\"Send by Email\" name=\"send_email\" widget=\"boolean_toggle\" options=\"{'autosave': False}\" invisible=\"survey_access_mode != 'public'\"/>\n                            <field name=\"partner_ids\" widget=\"many2many_tags_email\" placeholder=\"Add existing contacts...\" options=\"{'no_quick_create': True}\" context=\"{'show_email': True, 'form_view_ref': 'base.view_partner_simple_form'}\" required=\"True\" invisible=\"not send_email\"/>\n                            <field name=\"emails\" invisible=\"survey_users_login_required or not send_email\" placeholder=\"e.g.  'Rick Sanchez' &lt;rick_sanchez@example.com&gt;, hictor_vugo@example.com\"/>\n                        </group>\n                        <field name=\"existing_partner_ids\" invisible