   "declaration": "<field name=\"arch\" type=\"xml\">\n            <form string=\"Pricelist Rule\">\n                <sheet>\n                    <field name=\"name\" invisible=\"1\"/>\n                    <field name=\"company_id\" invisible=\"1\"/>\n                    <field name=\"price\" invisible=\"1\"/>\n                    <group name=\"pricelist_rule_computation\">\n                        <group name=\"pricelist_rule_method\">\n                            <field name=\"applied_on\" invisible=\"1\"/>\n                            <field name=\"display_applied_on\" string=\"Apply To\" widget=\"radio\" options=\"{'horizontal': true}\"/>\n                            <field name=\"categ_id\" options=\"{'no_create': 1}\" invisible=\"display_applied_on != '2_product_category'\" placeholder=\"All categories\"/>\n                            <field name=\"product_tmpl_id\" options=\"{'no_create': 1}\" invisible=\"display_applied_on != '1_product'\" placeholder=\"All products\"/>\n                            <field name=\"product_variant_count\" invisible=\"1\"/>\n                            <field name=\"product_id\" options=\"{'no_create': 1}\" invisible=\"product_variant_count &lt; 2\" placeholder=\"All variants\"/>\n                            <field name=\"compute_price\" string=\"Price Type\" widget=\"radio\" options=\"{'horizontal': true}\" invisible=\"display_applied_on == '1_product' and compute_price == 'fixed_price'\" groups=\"product.group_product_pricelist\"/>\n                            <label for=\"fixed_price\" invisible=\"compute_price != 'fixed'\"/>\n                            <div class=\"o_row\" invisible=\"compute_price != 'fixed'\" style=\"width: 60% !important;\">\n                                <field name=\"fixed_price\" widget=\"monetary\" options=\"{'currency_field': 'currency_id', 'field_digits': True}\"/>\n                                <span class=\"d-flex gap-2 p-0\" invisible=\"not product_uom_name\">per<field name=\"product_uom_name\"/></span>\n                            </div>\n                            <label for=\"percent_price\" string=\"Discount\" invisible=\"compute_price != 'percentage'\"/>\n                            <div class=\"o_row gap-3\" invisible=\"compute_price != 'percentage'\">\n                                <field name=\"percent_price\"/>\n                                <span>%</span>\n                                <t groups=\"product.group_product_pricelist\">\n                                    <span>on</span>\n                                    <field name=\"base_pricelist_id\" placeholder=\"sales price\" domain=\"[('id', '!=', pricelist_id)]\"/>\n                                </t>\n                            </div>\n                        </group>\n                        <group name=\"pricelist_rule_limits\">\n                            <field name=\"min_quantity\" string=\"Min Qty\"/>\n                            <field name=\"date_start\" string=\"Validity Period\" widget=\"daterange\" options=\"{'end_date_field': 'date_end'}\"/>\n                            <field name=\"date_end\" invisible=\"1\"/>\n                        </group>\n                    </group>\n                    <group name=\"pricelist_rule_base\" invisible=\"compute_price != 'formula'\">\n                        <group>\n                            <field name=\"base\" string=\"Based price\"/>\n                            <field name=\"base_pricelist_id\" invisible=\"base != 'pricelist'\" readonly=\"base != 'pricelist'\" required=\"compute_price == 'formula' and base == 'pricelist'\" string=\"Other Pricelist\"/>\n                            <label for=\"price_discount\" string=\"Discount\" invisible=\"base == 'standard_price'\"/>\n                            <div class=\"o_row\" invisible=\"base == 'standard_price'\" style=\"width: 40% !important;\">\n                                <field name=\"price_discount\"/>\n                                <span>%</span>\n                            </div>\n                            <label for=\"price_markup\" string=\"Markup\" invisible=\"base != 'standard_price'\"/>\n                            <div class=\"o_row\" invisible=\"base != 'standard_price'\" style=\"width: 40% !important;\">\n                                <field name=\"price_markup\"/>\n                                <span>%</span>\n                            </div>\n                            <field name=\"price_round\" string=\"Round off to\"/>\n                            <field name=\"price_surcharge\" widget=\"monetary\" options=\"{'currency_field': 'currency_id', 'field_digits': True}\"/>\n                            <label string=\"Margins\" for=\"price_min_margin\" groups=\"base.group_no_one\"/>\n                            <div class=\"d-flex align-items-baseline\" groups=\"base.group_no_one\">\n                                <field name=\"price_min_margin\" string=\"Min. Margin\" class=\"oe_inline\" widget=\"monetary\" options=\"{'field_digits': True}\"/>\n                                <i class=\"fa fa-long-arrow-right mx-2 oe_edit_only\" aria-label=\"Arrow icon\" title=\"Arrow\"/>\n                                <field name=\"price_max_margin\" string=\"Max. Margin\" class=\"oe_inline\" widget=\"monetary\" nolabel=\"1\" options=\"{'field_digits': True}\"/>\n                            </div>\n                        </group>\n                        <div>\n                            <div class=\"alert alert-info\" role=\"alert\" style=\"white-space: pre;\">\n                                <field name=\"rule_tip\"/>\n                            </div>\n                            <div class=\"alert alert-info\" role=\"alert\" style=\"white-space: pre;\">\n                                <b>Tip: want to round at 9.99?</b>\n                                <div>round off to 10.00 and set an extra at -0.01</div>\n                            </div>\n                        </div>\n                    </group>\n\n                    <group string=\"Company Settings\" groups=\"base.group_no_one\">\n                        <group name=\"pricelist_rule_related\">\n                            <field name=\"pricelist_id\" invisible=\"1\"/>\n                            <field name=\"currency_id\" groups=\"base.group_multi_currency\"/>\n                            <field name=\"company_id\" groups=\"base.group_multi_company\"/>\n                        </group>\n                    </group>\n                </sheet>\n            </form>\n        </field>\n    "
