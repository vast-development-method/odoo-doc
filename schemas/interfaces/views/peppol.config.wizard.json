   "declaration": "<field name=\"arch\" type=\"xml\">\n            <form>\n                <field name=\"company_id\" invisible=\"1\"/>\n                <field name=\"account_peppol_edi_user\" invisible=\"1\"/>\n                <div invisible=\"account_peppol_proxy_state != 'sender'\">\n                    You are sending your e-invoices via the system with this Peppol ID <field name=\"account_peppol_edi_identification\" class=\"oe_inline o_form_label\" readonly=\"1\"/>.\n                </div>\n                <div invisible=\"account_peppol_proxy_state != 'smp_registration'\">\n                    Your Peppol registration is being processed, it should be active within a day.\n                </div>\n                <div invisible=\"account_peppol_proxy_state != 'receiver'\">\n                    You are sending and receiving your e-invoices via the system with this Peppol ID <field name=\"account_peppol_edi_identification\" class=\"oe_inline o_form_label\" readonly=\"1\"/>.\n                </div>\n                <group string=\"Company information\">\n                    <label for=\"account_peppol_contact_email\" class=\"text-nowrap\"/>\n                    <field name=\"account_peppol_contact_email\" nolabel=\"1\" required=\"account_peppol_proxy_state in ('sender', 'smp_registration', 'receiver')\"/>\n                </group>\n                <div invisible=\"1\"> \n                    <group string=\"Receive your electronic invoices in the system\" invisible=\"account_peppol_proxy_state != 'sender'\">\n                        <div class=\"text-justify text-muted\" colspan=\"2\">\n                            Some service support migration keys. If this is your case you can enter your migration key below.\n                            If not, you should de-register from your current service provider and register with the system afterward.\n                        </div>\n                        <field name=\"account_peppol_migration_key\"/>\n                    </group>\n                    <group string=\"Self Billing\" invisible=\"account_peppol_proxy_state not in ('sender', 'receiver')\">\n                        <field name=\"peppol_activate_self_billing\" invisible=\"account_peppol_proxy_state not in ('sender', 'receiver')\"/>\n                        <field name=\"peppol_self_billing_reception_journal_id\" invisible=\"account_peppol_proxy_state != 'receiver'\"/>\n                    </group>\n                </div>\n                \n                \n                \n                <group string=\"Configure your Peppol Services and allowed formats\" invisible=\"1\">\n                    <div colspan=\"2\">\n                        <field name=\"service_info\" role=\"status\" class=\"o_field_html alert alert-info\" invisible=\"not service_info\"/>\n                        <field name=\"service_ids\" nolabel=\"1\" widget=\"one2many\" columns=\"2\">\n                            <list create=\"false\" delete=\"false\" edit=\"true\">\n                                <field name=\"wizard_id\" column_invisible=\"1\"/>\n                                <field name=\"document_name\" readonly=\"1\"/>\n                                <field name=\"document_identifier\" invisible=\"1\"/>\n                                <field name=\"enabled\" widget=\"boolean_toggle\"/>\n                            </list>\n                        </field>\n                    </div>\n                </group>\n                <group string=\"Danger zone\" invisible=\"account_peppol_proxy_state not in ('sender', 'smp_registration', 'receiver')\">\n                    <button string=\"Remove from Peppol\" name=\"button_peppol_unregister\" type=\"object\" class=\"btn btn-danger text-nowrap\" confirm=\"This will delete your Peppol registration.\"/>\n\n                        <button string=\"Enable reception\" name=\"button_peppol_register_sender_as_receiver\" type=\"object\" class=\"btn-secondary\" invisible=\"account_peppol_proxy_state != 'sender'\"/>\n\n                        <button string=\"Disable the reception.\" name=\"button_peppol_reset_to_sender\" type=\"object\" class=\"btn-secondary\" invisible=\"account_peppol_proxy_state not in ('smp_registration', 'receiver')\"/>\n                </group>\n                <footer>\n                    <button string=\"Save\" name=\"button_sync_form_with_peppol_proxy\" type=\"object\" class=\"btn-primary\" data-hotkey=\"q\"/>\n                    <button string=\"Discard\" class=\"btn-secondary\" special=\"cancel\" data-hotkey=\"x\"/>\n                </footer>\n            </form>\n        </field>\n    "
