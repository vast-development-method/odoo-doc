   "declaration": "<field name=\"arch\" type=\"xml\">\n            <form string=\"Send an SMS\">\n                \n                <div class=\"alert alert-danger text-center\" role=\"alert\" invisible=\"not res_model_description or not comment_single_recipient or recipient_single_valid\">\n                    <p class=\"my-0\">\n                        <strong>Invalid number:</strong>\n                        <span> make sure to set a country on the </span>\n                        <span><field name=\"res_model_description\"/></span>\n                        <span> or to specify the country code.</span>\n                    </p>\n                </div>\n\n                \n                <div class=\"alert alert-info text-center\" role=\"alert\" invisible=\"comment_single_recipient or recipient_invalid_count == 0\">\n                    <p class=\"my-0\">\n                        <field class=\"oe_inline fw-bold\" name=\"recipient_invalid_count\"/> out of\n                        <field class=\"oe_inline fw-bold\" name=\"res_ids_count\"/> recipients have an invalid phone number and will not receive this text message.\n                    </p>\n                </div>\n                <sheet>\n                    <group>\n                        <field name=\"composition_mode\" invisible=\"1\"/>\n                        <field name=\"comment_single_recipient\" invisible=\"1\"/>\n                        <field name=\"res_id\" invisible=\"1\"/>\n                        <field name=\"res_ids\" invisible=\"1\"/>\n                        <field name=\"res_model\" invisible=\"1\"/>\n                        <field name=\"mass_force_send\" invisible=\"1\"/>\n                        <field name=\"recipient_single_valid\" invisible=\"1\"/>\n                        <field name=\"recipient_single_number\" invisible=\"1\"/>\n                        <field name=\"number_field_name\" invisible=\"1\"/>\n                        <field name=\"numbers\" invisible=\"1\"/>\n                        <field name=\"sanitized_numbers\" invisible=\"1\"/>\n                        <field name=\"template_id\" invisible=\"1\"/>\n\n                        <label for=\"recipient_single_description\" string=\"To\" class=\"fw-bold\" invisible=\"not comment_single_recipient\"/>\n                        <div invisible=\"not comment_single_recipient\">\n                            <field name=\"recipient_single_description\" class=\"w-auto text-muted me-2\" invisible=\"not recipient_single_description\"/>\n                            <field name=\"recipient_single_number_itf\" class=\"oe_inline border-bottom\" nolabel=\"1\" onchange_on_keydown=\"True\" placeholder=\"e.g. +1 415 555 0100\"/>\n                        </div>\n                    </group>\n                        <field name=\"body\" widget=\"sms_widget\" invisible=\"comment_single_recipient or recipient_single_valid\" options=\"{'dynamic_placeholder': true, 'dynamic_placeholder_model_reference_field': 'res_model'}\" placeholder=\"Write a message...\"/>\n                        <field name=\"body\" widget=\"sms_widget\" invisible=\"comment_single_recipient or not recipient_single_valid\" default_focus=\"1\" options=\"{'dynamic_placeholder': true, 'dynamic_placeholder_model_reference_field': 'res_model'}\" placeholder=\"Write a message...\"/>\n                        <field name=\"body\" widget=\"sms_widget\" invisible=\"not comment_single_recipient\" placeholder=\"Write a message...\"/>\n                        <field name=\"mass_keep_log\" invisible=\"1\"/>\n                        <field name=\"use_exclusion_list\" invisible=\"1\"/>\n                </sheet>\n                <footer>\n                    \n                    <button string=\"Send\" type=\"object\" class=\"oe_highlight\" name=\"action_send_sms\" data-hotkey=\"q\" invisible=\"composition_mode not in ('comment', 'numbers') or not recipient_single_valid\"/>\n                    <button string=\"Send\" type=\"object\" class=\"oe_highlight\" name=\"action_send_sms\" data-hotkey=\"q\" invisible=\"composition_mode not in ('comment', 'numbers') or recipient_single_valid\" disabled=\"1\"/>\n                    <button string=\"Put in queue\" type=\"object\" class=\"oe_highlight\" name=\"action_send_sms\" data-hotkey=\"q\" invisible=\"composition_mode != 'mass'\"/>\n                    <button string=\"Send now\" type=\"object\" name=\"action_send_sms_mass_now\" data-hotkey=\"w\" invisible=\"composition_mode != 'mass'\"/>\n                    <button string=\"Discard\" class=\"btn btn-secondary\" special=\"cancel\" data-hotkey=\"x\"/>\n                </footer>\n            </form>\n        </field>\n    "
