   "declaration": "<field name=\"arch\" type=\"xml\">\n            <form string=\"Employee attendances\" duplicate=\"false\">\n                <header>\n                    <field name=\"overtime_status\" widget=\"statusbar\" readonly=\"1\" options=\"{'clickable': '1'}\" invisible=\"not overtime_status\"/>\n                </header>\n                <sheet>\n                    <group>\n                        <group colspan=\"2\">\n                            <group col=\"1\" name=\"group_employee\">\n                                <field id=\"employee_no_officer\" name=\"employee_id\" widget=\"many2one_avatar_employee\" readonly=\"1\" groups=\"!hr_attendance.group_hr_attendance_officer\"/>\n                                <field id=\"employee_no_manager\" name=\"employee_id\" widget=\"many2one_avatar_employee\" domain=\"[                                         ('attendance_manager_id', '=', uid),                                         ('company_id', 'in', allowed_company_ids),                                     ]\" groups=\"hr_attendance.group_hr_attendance_officer,!hr_attendance.group_hr_attendance_user\"/>\n                                <field id=\"employee_manager\" name=\"employee_id\" widget=\"many2one_avatar_employee\" domain=\"[                                         ('company_id', 'in', allowed_company_ids),                                     ]\" groups=\"hr_attendance.group_hr_attendance_user\"/>\n                                <field name=\"check_in\" options=\"{'rounding': 0}\" readonly=\"not is_manager\"/>\n                                <field name=\"check_out\" options=\"{'rounding': 0}\" placeholder=\"Currently Working\" readonly=\"not is_manager\"/>\n                            </group>\n                            <group col=\"2\">\n                                <field name=\"worked_hours\" string=\"Worked Time\" widget=\"float_time\"/>\n                                <field name=\"overtime_hours\" widget=\"float_time\" invisible=\"overtime_hours == validated_overtime_hours\"/>\n                                <label for=\"validated_overtime_hours\"/>\n                                <div>\n                                    <field name=\"validated_overtime_hours\" style=\"width:5ch\" widget=\"float_time\" readonly=\"1\"/>\n                                    \n                                    <button class=\"oe_stat_button flex-shrink-0\" string=\" \" help=\"Approve all overtimes for the same employee and date\" invisible=\"not is_manager or overtime_status not in ['to_approve', 'refused'] or not overtime_status\" name=\"action_approve_overtime\" icon=\"fa-check\" type=\"object\" groups=\"hr_attendance.group_hr_attendance_officer\"/>\n                                    <button class=\"oe_stat_button flex-shrink-0\" string=\" \" help=\"Refuse all overtimes for the same employee and date\" invisible=\"not is_manager or overtime_status not in ['to_approve', 'approved'] or not overtime_status\" name=\"action_refuse_overtime\" icon=\"fa-times\" type=\"object\" groups=\"hr_attendance.group_hr_attendance_officer\"/>\n                                </div>\n                            </group>\n                        </group>\n                        <separator string=\"Check In\"/>\n                        <group name=\"check_in_group\" colspan=\"2\">\n                            <group>\n                                <group>\n                                    <field name=\"in_mode\"/>\n                                    <field name=\"in_ip_address\" invisible=\"in_mode == 'manual' or not device_tracking_enabled\"/>\n                                    <field name=\"in_browser\" invisible=\"in_mode == 'manual' or not device_tracking_enabled\"/>\n                                </group>\n                            </group>\n                            <group invisible=\"in_mode == 'manual' or not device_tracking_enabled\">\n                                <field name=\"in_location\"/>\n                                <label for=\"in_latitude\" string=\"GPS Coordinates\"/>\n                                <div>\n                                    <div class=\"o_row\">\n                                        <span>\n                                            <field name=\"in_latitude\"/>\n                                        </span>,\n                                        <span>\n                                            <field name=\"in_longitude\" nolabel=\"1\"/>\n                                        </span>\n                                    </div>\n                                    <button name=\"action_in_attendance_maps\" type=\"object\" class=\"btn btn-link ps-0 pt-0 pb-2\" icon=\"oi-arrow-right\" string=\"View on Maps\" colspan=\"2\"/>\n                                </div>\n                            </group>\n                        </group>\n                        <separator string=\"Check Out\" name=\"check_out_separator\" invisible=\"not check_out\"/>\n                        <group colspan=\"2\" name=\"check_out_group\" invisible=\"not check_out\">\n                            <group>\n                                <group>\n                                    <field name=\"out_mode\" string=\"Mode\"/>\n                                    <field name=\"out_ip_address\" string=\"IP Address\" invisible=\"in_mode == 'manual' or not device_tracking_enabled\"/>\n                                    <field name=\"out_browser\" string=\"Browser\" invisible=\"in_mode == 'manual' or not device_tracking_enabled\"/>\n                                </group>\n                            </group>\n                            <group invisible=\"out_mode == 'manual' or not device_tracking_enabled\">\n                                <field name=\"out_location\"/>\n                                <label for=\"out_latitude\" string=\"GPS Coordinates\"/>\n                                <div>\n                                    <div class=\"o_row\">\n                                        <span>\n                                            <field name=\"out_latitude\"/>\n                                        </span>,\n                                        <span>\n                                            <field name=\"out_longitude\" nolabel=\"1\"/>\n                                        </span>\n                                    </div>\n                                    <button name=\"action_out_attendance_maps\" type=\"object\" class=\"btn btn-link ps-0 pt-0 pb-2\" icon=\"oi-arrow-right\" string=\"View on Maps\" colspan=\"2\"/>\n                                </div>\n                            </group>\n                        </group>\n                    </group>\n                    <notebook invisible=\"not overtime_status\">\n                        <page string=\"Overtime Details\">\n                            <field name=\"linked_overtime_ids\" readonly=\"1\">\n                                <list editable=\"bottom\">\n                                    <field name=\"rule_ids\" widget=\"many2many_tags\" readonly=\"1\"/>\n                                    <field name=\"duration\" widget=\"float_time\" readonly=\"1\"/>\n                                    <field name=\"manual_duration\" widget=\"float_time\" readonly=\"0\" column_invisible=\"1\"/>\n                                    <field name=\"amount_rate\" widget=\"percentage\"/>\n                                    <field name=\"status\" widget=\"badge\" readonly=\"1\" decoration-warning=\"status == 'to_approve'\" decoration-success=\"status == 'approved'\" decoration-danger=\"status == 'refused'\"/>\n                                    <button class=\"oe_stat_button\" string=\"Approve\" invisible=\"not is_manager or status not in ['to_approve', 'refused']\" name=\"action_approve\" icon=\"fa-check\" type=\"object\" groups=\"hr_attendance.group_hr_attendance_officer\"/>\n                                    <button class=\"oe_stat_button\" string=\"Refuse\" invisible=\"not is_manager or status not in ['to_approve', 'approved']\" name=\"action_refuse\" icon=\"fa-times\" type=\"object\" groups=\"hr_attendance.group_hr_attendance_officer\"/>\n                                </list>\n                            </field>\n                        </page>\n                    </notebook>\n                </sheet>\n                <chatter/>\n            </form>\n        </field>\n    "
  },
