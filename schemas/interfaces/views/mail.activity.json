   "declaration": "<field name=\"arch\" type=\"xml\">\n            <form string=\"Log an Activity\" create=\"false\">\n                <sheet string=\"Activity\">\n                    <div class=\"oe_button_box\" name=\"button_box\" invisible=\"1\">\n                        <button name=\"action_open_document\" type=\"object\" class=\"oe_link\" icon=\"fa-file-text-o\" invisible=\"not res_model or res_id == 0\">\n                                <div class=\"o_field_widget o_stat_info\">\n                                    <span class=\"o_stat_text\">Open Document</span>\n                                </div>\n                        </button>\n                    </div>\n                    <group invisible=\"1\">\n                        <field name=\"activity_category\" invisible=\"1\"/>\n                        <field name=\"res_model\" invisible=\"1\"/>\n                        <field name=\"res_model_id\" invisible=\"1\"/>\n                        <field name=\"res_id\" invisible=\"1\"/>\n                        <field name=\"chaining_type\" invisible=\"1\"/>\n                        <field name=\"previous_activity_type_id\"/>\n                        <field name=\"has_recommended_activities\"/>\n                    </group>\n                    <group invisible=\"not has_recommended_activities\">\n                        <field name=\"recommended_activity_type_id\" widget=\"selection_badge\" domain=\"[('previous_type_ids', '=', previous_activity_type_id)]\" string=\"Recommended Activities\"/>\n                    </group>\n\n                    <group>\n                        <field name=\"activity_type_id\" required=\"1\" widget=\"selection_badge_icons\" iconField=\"icon\" nolabel=\"1\"/>\n                        <field name=\"summary\" placeholder=\"e.g. Discuss Proposal\" class=\"fs-3 pb-2\"/>\n                        <group>\n                            <field name=\"date_deadline\"/>\n                        </group>\n                        <field name=\"user_id\" widget=\"many2one_avatar_user\"/>\n                    </group>\n                    <field name=\"note\" class=\"oe-bordered-editor embedded-editor-height-4\" placeholder=\"Log a note...\" options=\"{'embedded_components': false}\"/>\n                    <footer>\n                        <field name=\"id\" invisible=\"1\"/>\n                        <button id=\"mail_activity_schedule\" string=\"Schedule\" close=\"1\" name=\"action_close_dialog\" type=\"object\" class=\"btn-primary\" invisible=\"id\" data-hotkey=\"q\"/>\n                        <button id=\"mail_activity_save\" string=\"Save\" name=\"action_close_dialog\" type=\"object\" class=\"btn-primary\" invisible=\"not id\" data-hotkey=\"q\"/>\n                        <button invisible=\"chaining_type == 'trigger'\" string=\"Mark Done\" name=\"action_done\" type=\"object\" class=\"btn-secondary\" data-hotkey=\"w\" context=\"{'mail_activity_quick_update': True}\"/>\n                        <button string=\"Discard\" class=\"btn-secondary\" special=\"cancel\" data-hotkey=\"x\"/>\n                    </footer>\n                </sheet>\n            </form>\n        </field>\n    "
