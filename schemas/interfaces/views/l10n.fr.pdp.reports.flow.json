   "declaration": "<field name=\"arch\" type=\"xml\">\n            <form string=\"E-Reporting\" create=\"0\">\n                <header>\n                    <field name=\"state\" widget=\"statusbar\" statusbar_visible=\"pending,ready,error,sent,completed\"/>\n                    <button name=\"action_build_payload_manual\" type=\"object\" class=\"btn-secondary\" string=\"Build Payload\" invisible=\"state not in ['pending', 'error']\"/>\n                    <button name=\"action_open_send_wizard\" type=\"object\" class=\"btn-primary\" string=\"Send\" invisible=\"state not in ['ready', 'pending', 'error']\"/>\n                </header>\n                <sheet>\n                    <widget name=\"web_ribbon\" title=\"Sent\" bg_color=\"text-bg-success\" invisible=\"state not in ['sent', 'completed']\"/>\n                    <widget name=\"web_ribbon\" title=\"Error\" bg_color=\"text-bg-danger\" invisible=\"state != 'error' or not transport_status or transport_status not in ['ERROR', 'REFUSED']\"/>\n                    <div class=\"oe_button_box\" name=\"button_box\">\n                        <button type=\"object\" name=\"action_view_moves\" class=\"oe_stat_button\" icon=\"fa-file-text-o\" invisible=\"not move_ids\">\n                            <field name=\"move_ids\" string=\"Invoices\" widget=\"statinfo\" invisible=\"report_type == 'payment'\"/>\n                            <field name=\"move_ids\" string=\"Payments\" widget=\"statinfo\" invisible=\"report_type == 'transaction'\"/>\n                        </button>\n                        <button type=\"object\" name=\"action_view_initial\" class=\"oe_stat_button\" icon=\"fa-file-text-o\" invisible=\"not initial_flow_id\">\n                            <div>Initial</div>\n                        </button>\n                    </div>\n                    <div class=\"alert alert-warning\" role=\"alert\" invisible=\"not error_moves_count or period_status == 'open'\">\n                        <span>\n                            Some invoices were excluded because of validation errors.\n                            <button type=\"object\" name=\"action_view_error_moves\" class=\"btn-link\">View invoices</button>\n                        </span>\n                    </div>\n                    <group>\n                        <group>\n                            <field name=\"name\" readonly=\"1\"/>\n                            <field name=\"report_type\" string=\"Type\" readonly=\"1\"/>\n                            <field name=\"state\" string=\"Status\" readonly=\"1\"/>\n                            <field name=\"transmission_type\" string=\"Transmission type\" help=\"Type of transmission per Flux 10 v1.2: IN (Initial) or RE (Rectificative). No references to previous flows in v1.2.\"/>\n                        </group>\n                        <group>\n                            <field name=\"period_start\" string=\"Start date\" readonly=\"1\"/>\n                            <field name=\"period_end\" string=\"End date\" readonly=\"1\"/>\n                            <field name=\"period_status\" string=\"Period status\" readonly=\"1\" widget=\"badge\" decoration-info=\"period_status == 'open'\" decoration-warning=\"period_status == 'grace'\" decoration-danger=\"period_status == 'closed'\"/>\n                            <label string=\"Due Period Start\" for=\"due_period_start\" invisible=\"due_period_start == due_period_end\"/>\n                            <label string=\"Due Date\" for=\"due_period_start\" invisible=\"due_period_start != due_period_end\"/>\n                            <field name=\"due_period_start\" readonly=\"1\" nolabel=\"1\"/>\n                            <field name=\"due_period_end\" readonly=\"1\" invisible=\"due_period_start == due_period_end\"/>\n                            \n                        </group>\n                    </group>\n                </sheet>\n                <chatter/>\n            </form>\n        </field>\n    "
  },
