   "declaration": "<field name=\"arch\" type=\"xml\">\n            <form>\n                <sheet>\n                    <h1>\n                        <field name=\"name\" readonly=\"not datas\"/>\n                    </h1>\n                    <group>\n                        <group>\n                            <field name=\"document_type\"/>\n                            <label for=\"datas\"/>\n                            <div class=\"o_row\">\n                                <field name=\"datas\" filename=\"name\" options=\"{'accepted_file_extensions': '.pdf', 'allowed_mime_type' : 'application/pdf'}\" class=\"oe_inline\"/>\n                                <button name=\"action_open_pdf_form_fields\" type=\"object\" string=\"Configure dynamic fields\" help=\"Mark fields as safe to fill in the quote.\" class=\"btn btn-link\" icon=\"fa-pencil\" colspan=\"2\" groups=\"base.group_system,base.group_no_one\" invisible=\"not (datas and form_field_ids)\"/>\n                            </div>\n                            <field name=\"quotation_template_ids\" options=\"{'no_create': True}\" widget=\"many2many_tags\"/>\n                            <field name=\"add_by_default\"/>\n                        </group>\n                    </group>\n                    <group string=\"Attached To\" groups=\"base.group_multi_company,base.group_no_one\">\n                        <field name=\"company_id\" placeholder=\"Visible to all\" groups=\"base.group_multi_company\" options=\"{'no_create': True}\" class=\"oe_inline\"/>\n                        <field name=\"form_field_ids\" groups=\"base.group_no_one\" widget=\"many2many_tags\"/>\n                    </group>\n                    <group string=\"History\" groups=\"base.group_no_one\" invisible=\"not create_date\">\n                        <label for=\"create_uid\" string=\"Creation\"/>\n                        <div name=\"creation_div\">\n                            <field name=\"create_uid\" readonly=\"1\" class=\"oe_inline\"