   "declaration": "<field name=\"arch\" type=\"xml\">\n            <form string=\"Product Attribute\">\n            <field name=\"number_related_products\" invisible=\"1\"/>\n            <sheet>\n                <widget name=\"web_ribbon\" title=\"Archived\" bg_color=\"text-bg-danger\" invisible=\"active\"/>\n                <div class=\"oe_button_box\" name=\"button_box\">\n                    <button name=\"action_open_product_template_attribute_lines\" type=\"object\" class=\"oe_stat_button\" icon=\"fa-bars\" invisible=\"not number_related_products\">\n                        <div class=\"o_stat_info\">\n                            <span class=\"o_stat_value\"><field name=\"number_related_products\"/></span>\n                            <span class=\"o_stat_text\">Products</span>\n                        </div>\n                    </button>\n                </div>\n                <group name=\"main_fields\">\n                    <group name=\"sale_main_fields\">\n                        <label for=\"name\" string=\"Attribute Name\"/>\n                        <field name=\"name\" nolabel=\"1\"/>\n                        <field name=\"display_type\" widget=\"radio\" options=\"{'horizontal': True}\"/>\n                        <field name=\"create_variant\" widget=\"radio\" options=\"{'horizontal': True}\" readonly=\"number_related_products != 0 or display_type == 'multi'\" force_save=\"1\"/>\n                    </group>\n                </group>\n                <notebook>\n                    <page string=\"Attribute Values\" name=\"attribute_values\">\n                        <field name=\"value_ids\" widget=\"pavs_one2many\" nolabel=\"1\">\n                            <list string=\"Values\" editable=\"bottom\">\n                                <field name=\"sequence\" widget=\"handle\"/>\n                                <field name=\"name\"/>\n                                <field name=\"display_type\" column_invisible=\"True\"/>\n                                <field name=\"is_custom\" width=\"120px\" column_invisible=\"parent.display_type == 'multi'\"/>\n                                <field name=\"html_color\" widget=\"color\" column_invisible=\"parent.display_type != 'color'\" invisible=\"image\"/>\n                                <field name=\"image\" widget=\"image\" options=\"{'size': [70, 70]}\" class=\"oe_avatar text-start float-none\" column_invisible=\"parent.display_type not in ['color', 'image']\"/>\n                                <field name=\"default_extra_price\" width=\"160px\"/>\n                                <button name=\"action_add_to_products\" string=\"Add to products\" type=\"object\" icon=\"fa-plus\" column_invisible=\"parent.number_related_products &lt; 1\" invisible=\"pav_attribute_line_ids\"/>\n                                <button name=\"action_update_prices\" string=\"Update extra prices\" type=\"object\" icon=\"fa-refresh\" column_invisible=\"parent.number_related_products &lt; 1\" invisible=\"not pav_attribute_line_ids or not default_extra_price_changed\"/>\n                            </list>\n                        </field>\n                    </page>\n                </notebook>\n            </sheet>\n            </form>\n        </field>\n    "
