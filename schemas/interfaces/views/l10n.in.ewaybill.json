   "declaration": "<field name=\"arch\" type=\"xml\">\n            <form string=\"Ewaybill\" create=\"false\">\n                <header>\n                    <button name=\"action_generate_ewaybill\" string=\"Generate e-Waybill\" class=\"oe_highlight\" type=\"object\" invisible=\"state != 'pending'\" data-hotkey=\"g\"/>\n                    <button name=\"action_cancel_ewaybill\" string=\"Cancel e-Waybill\" type=\"object\" invisible=\"state != 'generated'\" data-hotkey=\"c\"/>\n                    <button name=\"action_reset_to_pending\" string=\"Reset to Pending\" type=\"object\" invisible=\"state in ['pending', 'generated']\" data-hotkey=\"r\" confirm=\"Are you sure you want to re-send the e-Waybill?\"/>\n                    <button name=\"action_print\" string=\"Print\" class=\"oe_highlight\" type=\"object\" invisible=\"state != 'generated'\" data-hotkey=\"f\"/>\n                    <button name=\"action_export_content_json\" string=\"Download Content JSON\" type=\"object\" class=\"oe_highlight\" invisible=\"not error_message\" groups=\"base.group_no_one\"/>\n                    <field name=\"state\" widget=\"statusbar\" statusbar_visible=\"pending,generated\"/>\n                </header>\n                <div class=\"alert alert-danger\" role=\"alert\" style=\"margin-bottom:0px;\" invisible=\"not error_message or blocking_level == 'warning'\">\n                    <div class=\"o_row\">\n                        <field name=\"error_message\"/>\n                    </div>\n                </div>\n                <div class=\"alert alert-warning\" role=\"alert\" style=\"margin-bottom:0px;\" invisible=\"not error_message or blocking_level == 'error'\">\n                    <div class=\"o_row\">\n                        <field name=\"error_message\"/>\n                    </div>\n                </div>\n                <sheet>\n                    <div class=\"oe_title\">\n                        <h1 invisible=\"not name\">\n                            <field name=\"name\" readonly=\"1\"/>\n                        </h1>\n                    </div>\n                    <group name=\"document_details\" string=\"Document Details\">\n                        <group>\n                            <field name=\"type_id\" widget=\"selection\" readonly=\"state != 'pending'\" domain=\"[('allowed_supply_type', 'in', (supply_type == 'I' and 'in' or 'out', 'both'))]\" required=\"True\"/>\n                        </group>\n                        <group>\n                            <field name=\"ewaybill_date\" invisible=\"not ewaybill_date\"/>\n                            <field name=\"document_number\"/>\n                            <field name=\"document_date\" readonly=\"1\" widget=\"datetime\" options=\"{'show_time': false}\"/>\n                        </group>\n                    </group>\n                    <group name=\"partners\" string=\"Address Details\">\n                    <field name=\"account_move_id\" invisible=\"1\"/> \n                        <group>\n                            <field name=\"partner_bill_from_id\" force_save=\"1\" readonly=\"state == 'pending' and not is_bill_from_editable or state != 'pending'\"/>\n                            <field name=\"partner_bill_to_id\" force_save=\"1\" readonly=\"state == 'pending' and not is_bill_to_editable or state != 'pending'\"/>\n                        </group>\n                        <group>\n                            <field name=\"partner_ship_from_id\" force_save=\"1\" readonly=\"state == 'pending' and not is_ship_from_editable or state != 'pending'\"/>\n                            <field name=\"partner_ship_to_id\" force_save=\"1\" readonly=\"state == 'pending' and not is_ship_to_editable or state != 'pending'\"/>\n                        </group>\n                    </group>\n                    <group name=\"transporter\" string=\"Transporter Details\">\n                        <group>\n                            <field name=\"transporter_id\" readonly=\"state != 'pending'\" required=\"not mode\"/>\n                        </group>\n                        <group/>\n                    </group>\n                    <group name=\"part_b\" string=\"Transportation Details (Part B)\">\n                        <group>\n                            <field name=\"mode\" readonly=\"state != 'pending'\"/>\n                            <field name=\"vehicle_type\" invisible=\"mode not in ('1','4')\" required=\"mode == '1'\" readonly=\"state != 'pending'\"/>\n                            <field name=\"vehicle_no\" invisible=\"mode not in ('1','4')\" required=\"mode == '1' and not transportation_doc_no\" readonly=\"state != 'pending'\"/>\n                            <label for=\"distance\" readonly=\"state != 'pending'\"/>\n                            <div class=\"o_row\" name=\"distance\">\n                                <field name=\"distance\" readonly=\"state != 'pending'\"/>\n                                <span>km</span>\n                            </div>\n                        </group>\n                        <group>\n                            <label for=\"transportation_doc_no\" invisible=\"mode != '1'\"/>\n                            <label for=\"transportation_doc_no\" string=\"RR No\" invisible=\"mode != '2'\"/>\n                            <label for=\"transportation_doc_no\" string=\"Airway Bill\" invisible=\"mode != '3'\"/>\n                            <label for=\"transportation_doc_no\" invisible=\"mode != '4'\" string=\"Bill of lading No\"/>\n                            <div class=\"o_row\">\n                                <field name=\"transportation_doc_no\" readonly=\"state != 'pending'\" required=\"mode in ('2', '3', '4')\" invisible=\"not mode\"/>\n                            </div>\n\n\n                            <label for=\"transportation_doc_date\" invisible=\"mode != '1'\"/>\n                            <label for=\"transportation_doc_date\" string=\"RR Date\" invisible=\"mode != '2'\"/>\n                            <label for=\"transportation_doc_date\" string=\"Airway Bill Date\" invisible=\"mode != '3'\"/>\n                            <label for=\"transportation_doc_date\" string=\"Bill of lading Date\" invisible=\"mode != '4'\"/>\n                            <div class=\"o_row\">\n                                <field name=\"transportation_doc_date\" readonly=\"state != 'pending'\" required=\"mode in ('2', '3', '4')\" invisible=\"not mode\"/>\n                            </div>\n                        </group>\n                    </group>\n                    <group name=\"cancel_ewaybill\" string=\"Cancel details\" invisible=\"state != 'cancel'\">\n                        <group>\n                            <field name=\"cancel_reason\" readonly=\"state != 'generated'\"/>\n                            <field name=\"cancel_remarks\" readonly=\"state != 'generated'\"/>\n                        </group>\n                        <group>\n                        </group>\n                    </group>\n                </sheet>\n                \n                <chatter/>\n            </form>\n        </field>\n    "
