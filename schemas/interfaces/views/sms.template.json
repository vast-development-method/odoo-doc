   "declaration": "<field name=\"arch\" type=\"xml\">\n            <form string=\"SMS Templates\">\n                <header>\n                    <field name=\"template_fs\" invisible=\"1\"/>\n                    <button string=\"Reset Template\" name=\"%(sms_template_reset_action)d\" type=\"action\" groups=\"base.group_system\" invisible=\"not template_fs\"/>\n                </header>\n                <sheet>\n                    <div class=\"oe_button_box\" name=\"button_box\">\n                        <field name=\"sidebar_action_id\" invisible=\"1\"/>\n                        <button name=\"action_create_sidebar_action\" type=\"object\" groups=\"base.group_no_one\" class=\"oe_stat_button\" invisible=\"sidebar_action_id\" icon=\"fa-plus\" help=\"Add a contextual action on the related model to open a sms composer with this template\">\n                            <div class=\"o_field_widget o_stat_info\">\n                                <span class=\"o_stat_text\">Add</span>\n                                <span class=\"o_stat_text\">Context Action</span>\n                            </div>\n                        </button>\n                        <button name=\"action_unlink_sidebar_action\" type=\"object\" groups=\"base.group_no_one\" class=\"oe_stat_button\" icon=\"fa-minus\" invisible=\"not sidebar_action_id\" help=\"Remove the contextual action of the related model\" widget=\"statinfo\">\n                            <div class=\"o_field_widget o_stat_info\">\n                                <span class=\"o_stat_text\">Remove</span>\n                                <span class=\"o_stat_text\">Context Action</span>\n                            </div>\n                        </button>\n                        <button class=\"oe_stat_button\" name=\"%(sms_template_preview_action)d\" icon=\"fa-search-plus\" type=\"action\" target=\"new\">\n                            <div class=\"o_field_widget o_stat_info\">\n                                <span class=\"o_stat_text\">Preview</span>\n                            </div>\n                        </button>\n                    </div>\n                    <div class=\"oe_title\">\n                        <label for=\"name\" string=\"SMS Template\"/>\n                        <h1><field name=\"name\" placeholder=\"e.g. Calendar Reminder\" required=\"1\"/></h1>\n                        <group>\n                            <field name=\"model_id\" placeholder=\"e.g. Contact\" required=\"1\" options=\"{'no_create': True}\"/>\n                            <field name=\"model\" invisible=\"1\"/>\n                            <field name=\"lang\" groups=\"base.group_no_one\" placeholder=\"e.g. en_US or {{ object.partner_id.lang }}\"/>\n                        </group>\n                    </div>\n                    <notebook>\n                        <page string=\"Content\" name=\"content\">\n                            <group>\n                                <field name=\"body\" widget=\"sms_widget\" nolabel=\"1\"/>\n                            </group>\n                        </page>\n                    </notebook>\n                </sheet>\n            </form>\n        </field>\n    "
