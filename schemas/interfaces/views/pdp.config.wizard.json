   "declaration": "<field name=\"arch\" type=\"xml\">\n            <form>\n                <div invisible=\"account_peppol_proxy_state != 'sender'\">\n                    You are sending your e-invoices via the system with this Peppol ID <field name=\"account_peppol_edi_identification\" class=\"oe_inline o_form_label\" readonly=\"1\"/>.\n                </div>\n                <div invisible=\"account_peppol_proxy_state not in ('smp_registration', 'receiver')\">\n                    You are sending and receiving your e-invoices via the system with this ID <field name=\"account_peppol_edi_identification\" class=\"oe_inline o_form_label\" readonly=\"1\"/>.\n                </div>\n                <group string=\"Company information\">\n                    <label for=\"account_peppol_contact_email\" class=\"text-nowrap\"/>\n                    <field name=\"account_peppol_contact_email\" nolabel=\"1\" required=\"account_peppol_proxy_state in ('sender', 'smp_registration', 'receiver')\"/>\n                </group>\n                <group string=\"Danger zone\" invisible=\"account_peppol_proxy_state not in ('sender', 'smp_registration', 'receiver')\">\n                    <button string=\"Disconnect French electronic invoicing\" name=\"button_peppol_unregister\" type=\"object\" class=\"btn btn-danger text-nowrap\" confirm=\"This will delete your French electronic invoicing registration.\"/>\n                </group>\n                <footer>\n                    <button string=\"Save\" name=\"button_sync_form_with_peppol_proxy\" type=\"object\" class=\"btn-primary\" data-hotkey=\"q\"/>\n                    <button string=\"Discard\" class=\"btn-secondary\" special=\"cancel\" data-hotkey=\"x\"/>\n                </footer>\n            </form>\n        </field>\n    "
