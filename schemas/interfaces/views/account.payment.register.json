  <field name=\"analytic_distribution\" widget=\"analytic_distribution\" groups=\"analytic.group_analytic_accounting\" optional=\"hide\" width=\"200px\"/> \n                                    <field name=\"amount\" sum=\"Total Withheld Amount\"/>\n                                </list>\n                            </field>\n                        </group>\n                        <group>\n                            <group>\n                                <field name=\"withholding_outstanding_account_id\" required=\"should_withhold_tax and withholding_line_ids and not withholding_payment_account_id\" invisible=\"(not withholding_line_ids) or withholding_payment_account_id or not display_withholding\"/>\n                            </group>\n                            <group>\n                                <field name=\"withholding_net_amount\"/>\n                            </group>\n                        </group>\n                    </page>\n                </notebook>\n            </footer>\n        </field>\n    "
