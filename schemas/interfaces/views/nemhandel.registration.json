   "declaration": "<field name=\"arch\" type=\"xml\">\n            <form>\n                <sheet>\n                    <group name=\"nemhandel_registration\" invisible=\"l10n_dk_nemhandel_proxy_state not in ('not_registered', 'in_verification')\">\n                        <div colspan=\"2\" class=\"text-muted mb-3\" invisible=\"l10n_dk_nemhandel_proxy_state != 'not_registered'\">\n                            Send invoices and receive bills automatically on the Nemhandel network.\n                        </div>\n\n                        \n                        <field name=\"identifier_type\" string=\"Identifier Type\" nolabel=\"1\" invisible=\"l10n_dk_nemhandel_proxy_state != 'not_registered'\" class=\"o_field_peppol_eas_selection\"/>\n                        <field name=\"identifier_value\" string=\"Identifier Value\" nolabel=\"1\" invisible=\"l10n_dk_nemhandel_proxy_state != 'not_registered'\"/>\n                        <field name=\"contact_email\" string=\"Email\" invisible=\"l10n_dk_nemhandel_proxy_state != 'not_registered'\"/>\n                        <field name=\"phone_number\" string=\"Phone\" required=\"edi_mode != 'demo'\" invisible=\"l10n_dk_nemhandel_proxy_state != 'not_registered'\"/>\n\n                        \n                        <div colspan=\"2\" name=\"kyc\" invisible=\"l10n_dk_nemhandel_proxy_state != 'in_verification'\" class=\"mb-4\">\n                            <div class=\"text-muted mt-3\">\n                                Fill in the code below that we sent you by SMS to\n                                <field name=\"phone_number\" class=\"oe_inline\" nolabel=\"1\" readonly=\"l10n_dk_nemhandel_proxy_state == 'in_verification'\"/>\n                            </div>\n                            <div class=\"mt-1 ps-3 w-50\">\n                                <field name=\"verification_code\" widget=\"nemhandel_verification_code\"/>\n                            </div>\n                        </div>\n                    </group>\n\n                    \n                    <div colspan=\"2\" class=\"row\" invisible=\"l10n_dk_nemhandel_proxy_state != 'not_registered'\">\n                        <div class=\"text-muted col\" invisible=\"edi_mode != 'prod'\">\n                            By clicking the button below I accept that the system may process my e-invoices.\n                        </div>\n                        <div class=\"text-muted col\" invisible=\"edi_mode != 'test'\">\n                            Test mode allows sending e-invoices through the test Nemhandel network.\n                            By clicking the button below I accept that the system may process my e-invoices.\n                        </div>\n                        <div class=\"text-muted col\" invisible=\"edi_mode != 'demo'\">\n                            In demo mode sending invoices is simulated.\n                            There will be no communication with the Nemhandel network.\n                        </div>\n                    </div>\n                </sheet>\n\n                <footer>\n                    <div name=\"nemhandel_send_code\" invisible=\"l10n_dk_nemhandel_proxy_state != 'not_registered'\">\n                        <button string=\"Activate Nemhandel\" name=\"button_nemhandel_registration_sms\" type=\"object\" class=\"btn-primary\" data-hotkey=\"q\" invisible=\"edi_mode != 'prod'\"/>\n                        <button string=\"Activate Nemhandel (Test)\" name=\"button_nemhandel_registration_sms\" type=\"object\" class=\"btn-primary\" data-hotkey=\"q\" invisible=\"edi_mode != 'test'\"/>\n                        <button string=\"Activate Nemhandel (Demo)\" name=\"button_check_nemhandel_verification_code\" type=\"object\" class=\"btn-primary\" data-hotkey=\"q\" invisible=\"edi_mode != 'demo'\"/>\n                    </div>\n                    <div name=\"nemhandel_check_code\" invisible=\"l10n_dk_nemhandel_proxy_state != 'in_verification'\">\n                        <button string=\"Confirm\" name=\"button_check_nemhandel_verification_code\" type=\"object\" class=\"btn-primary\" data-hotkey=\"q\"/>\n                    </div>\n                    <button string=\"Send again\" name=\"send_nemhandel_verification_code\" type=\"object\" class=\"btn-secondary\" invisible=\"l10n_dk_nemhandel_proxy_state != 'in_verification'\"/>\n                    <button name=\"button_deregister_nemhandel_participant\" string=\"Cancel Registration\" type=\"object\" class=\"btn-secondary\" data-hotkey=\"x\"/>\n                </footer>\n            </form>\n        </field>\n    "
