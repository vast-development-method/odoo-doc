   "declaration": "<field name=\"arch\" type=\"xml\">\n            <form>\n                <header>\n                </header>\n                <field name=\"first_step_warning\" invisible=\"1\"/>\n                <div class=\"alert alert-info text-center\" role=\"alert\" invisible=\"first_step_warning != 'first_step_operator'\">\n                    <span>Tip: At least one interaction (Question, Email, ...) is needed before the Bot can perform more complex actions (Forward to an Operator, ...). </span>\n                    <span>Use Channel Rules if you want the Bot to interact with visitors only when no operator is available.</span>\n                </div>\n                <div class=\"alert alert-info text-center\" role=\"alert\" invisible=\"first_step_warning != 'first_step_invalid'\">\n                    <span>Tip: At least one interaction (Question, Email, ...) is needed before the Bot can perform more complex actions (Forward to an Operator, ...).</span>\n                </div>\n                <sheet>\n                    <div class=\"oe_button_box\" name=\"button_box\">\n                        <button name=\"action_view_livechat_channels\" type=\"object\" class=\"oe_stat_button\" icon=\"fa-comments\" invisible=\"livechat_channel_count == 0\">\n                            <field name=\"livechat_channel_count\" string=\"Channels\" widget=\"statinfo\"/>\n                        </button>\n                    </div>\n                    <field name=\"active\" invisible=\"1\"/>\n                    <widget name=\"web_ribbon\" title=\"Archived\" bg_color=\"text-bg-danger\" invisible=\"active\"/>\n                    <field name=\"image_1920\" widget=\"image\" class=\"oe_avatar\" options=\"{'preview_image': 'image_128'}\"/>\n                    <div class=\"oe_title\">\n                        <label for=\"title\" string=\"Chatbot Name\"/>\n                        <h1><field name=\"title\" default_focus=\"1\" placeholder=\"e.g. &quot;Meeting Scheduler Bot&quot;\"/></h1>\n                    </div>\n                    <notebook>\n                        <page string=\"Script\" name=\"page_script\">\n                            <field name=\"script_step_ids\" widget=\"chatbot_steps_one2many\" nolabel=\"1\" context=\"{'chatbot_script_answer_display_short_name': 1}\"/>\n                        </page>\n                    </notebook>\n                </sheet>\n            </form>\n        </field>\n    "
  },
