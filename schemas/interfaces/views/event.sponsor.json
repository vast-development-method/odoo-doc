   "declaration": "<field name=\"arch\" type=\"xml\">\n            <form>\n                <sheet>\n                    <div class=\"oe_button_box\" name=\"button_box\">\n                        <field name=\"website_url\" invisible=\"1\"/>\n                        <field name=\"is_published\" widget=\"website_redirect_button\" invisible=\"exhibitor_type == 'sponsor'\"/>\n                    </div>\n                    <widget name=\"web_ribbon\" title=\"Archived\" bg_color=\"text-bg-danger\" invisible=\"active\"/>\n                    <field name=\"active\" invisible=\"1\"/>\n                    <field name=\"image_512\" widget=\"image\" class=\"oe_avatar\"/>\n                    <div class=\"oe_title\">\n                        <label for=\"name\" string=\"Sponsor Name\"/>\n                        <h1><field name=\"name\" placeholder=\"e.g. : OpenWood Decoration\"/></h1>\n                        <div class=\"oe_title\">\n                            <label for=\"subtitle\"/>\n                            <field name=\"subtitle\" placeholder=\"e.g. Your best choice for your home\"/>\n                        </div>\n                    </div>\n                    <group>\n                        <group>\n                            <field name=\"partner_id\" string=\"Partner\"/>\n                            <field name=\"email\" widget=\"email\" string=\"Email\" placeholder=\"e.g. : open.wood.decoration@example.com\"/>\n                            <field name=\"phone\" widget=\"phone\" string=\"Phone\" options=\"{'enable_sms': True}\"/>\n                            <field name=\"url\" widget=\"url\" string=\"Website\" placeholder=\"e.g. : https://www.the system.com\"/>\n                        </group>\n                        <group>\n                            <field name=\"event_id\" placeholder=\"All Events\"/>\n                            <field name=\"sponsor_type_id\"/>\n                            <field name=\"exhibitor_type\" required=\"1\"/>\n                            \n                            <field name=\"website_published\" widget=\"boolean_toggle\" string=\"Display on website footer\" invisible=\"exhibitor_type != 'sponsor'\"/>\n                            <label for=\"hour_from\" string=\"Opening Hours\" invisible=\"exhibitor_type == 'sponsor'\"/>\n                            <div class=\"o_row\" invisible=\"exhibitor_type == 'sponsor'\">\n                                <field name=\"hour_from\" widget=\"float_time\" nolabel=\"1\" class=\"oe_inline\"/>\n                                <i class=\"fa fa-long-arrow-right mx-2\" aria-label=\"Arrow icon\" title=\"Arrow\"/>\n                                <field name=\"hour_to\" widget=\"float_time\" nolabel=\"1\" class=\"oe_inline\"/>\n                                <field name=\"event_date_tz\" nolabel=\"1\" class=\"oe_inline\"/>\n                            </div>\n                            <field name=\"show_on_ticket\"/>\n                        </group>\n                    </group>\n                    <notebook>\n                        <page string=\"Description\" name=\"page_description\" invisible=\"exhibitor_type == 'sponsor'\">\n                            <field name=\"website_description\" nolabel=\"1\" options=\"{'allowVideo': True}\" placeholder=\"e.g. &quot;Openwood specializes in home decoration...&quot;\"/>\n                        </page>\n                    </notebook>\n                </sheet>\n                <chatter/>\n            </form>\n        </field>\n    "
