   "declaration": "<field name=\"arch\" type=\"xml\">\n            <form string=\"Payment Method\">\n                <sheet>\n                    <field name=\"is_primary\" invisible=\"True\"/>\n                    <field name=\"image\" widget=\"image\" class=\"oe_avatar\"/>\n                    <div class=\"oe_title\">\n                        <h1><field name=\"name\" placeholder=\"Name\"/></h1>\n                    </div>\n                    <group>\n                        <field name=\"code\" invisible=\"id\"/>\n                        <field name=\"code\" invisible=\"not id\" readonly=\"id\" groups=\"base.group_no_one\"/>\n                        <field name=\"primary_payment_method_id\" invisible=\"is_primary\"/>\n                        <field name=\"active\"/>\n                        <label for=\"supported_country_ids\"/>\n                        <div>\n                            <field name=\"supported_country_ids\" class=\"oe_inline\" widget=\"many2many_tags\" readonly=\"1\"/>\n                            <span class=\"oe_inline text-muted\" invisible=\"supported_country_ids\">\n                                All countries are supported.\n                            </span>\n                        </div>\n                        <label for=\"supported_currency_ids\"/>\n                        <div>\n                            <field name=\"supported_currency_ids\" class=\"oe_inline\" widget=\"many2many_tags\" readonly=\"1\"/>\n                            <span class=\"oe_inline text-muted\" invisible=\"supported_currency_ids\">\n                                All currencies are supported.\n                            </span>\n                        </div>\n                    </group>\n                    <notebook>\n                        <page string=\"Providers\" name=\"providers\">\n                            <field name=\"provider_ids\" readonly=\"1\">\n                                <list decoration-muted=\"state == 'disabled'\" editable=\"bottom\">\n                                    <field name=\"name\"/>\n                                    <field name=\"state\"/>\n                                </list>\n                            </field>\n                        </page>\n                        <page string=\"Brands\" name=\"brands\" invisible=\"not is_primary\">\n                            <field name=\"brand_ids\"/>\n                        </page>\n                        <page string=\"Configuration\" name=\"configuration\" groups=\"base.group_no_one\">\n                            <div class=\"alert alert-warning\" role=\"alert\">\n                                <i class=\"fa fa-exclamation-triangle\"/> These properties are set to\n                                match the behavior of providers and that of their integration with\n                                the system regarding this payment method. Any change may result in errors\n                                and should be tested on a test database first.\n                            </div>\n                            <group>\n                                <field name=\"support_tokenization\"/>\n                                <field name=\"support_manual_capture\"/>\n                                <field name=\"support_express_checkout\"/>\n                                <field name=\"support_refund\"/>\n                                <field name=\"supported_country_ids\" widget=\"many2many_tags\" placeholder=\"Select countries. Leave empty to allow any.\"/>\n                                <field name=\"supported_currency_ids\" widget=\"many2many_tags\" placeholder=\"Select currencies. Leave empty to allow any.\"/>\n                                <field name=\"provider_ids\" string=\"Supported by\" widget=\"many2many_tags\"/>\n                            </group>\n                        </page>\n                    </notebook>\n                </sheet>\n            </form>\n        </field>\n    "
