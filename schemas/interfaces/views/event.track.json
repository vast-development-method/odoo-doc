on\" groups=\"base.group_user\"/>\n                                <div t-att-title=\"record.partner_id.value\">\n                                    <field name=\"partner_id\" widget=\"image\" options=\"{'preview_image': 'avatar_128'}\" class=\"o_avatar rounded ms-1\"/>\n                                </div>\n                            </div>\n                        </footer>\n                    </t>\n                </templates>\n            </kanban>\n        </field>\n    "
  },
