{
  "title": "Calculation record",
  "description": "One calculation of a domain, mirrored from its calculations.md document in a form that a rebuild can test against.",
  "type": "object",
  "required": ["identifier", "name", "document", "purpose", "operands", "preconditions", "procedure", "formula", "rounding", "result", "edge_cases", "worked_examples", "related_rules"],
  "properties": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9-]+-[0-9]{3}$"},
    "name": {"type": "string"},
    "document": {"type": "string", "description": "Relative path from the repository root to the calculations.md file, with a heading anchor"},
    "purpose": {"type": "string"},
    "operands": {"type": "array", "items": {"type": "object", "required": ["name", "unit_or_currency", "source"], "properties": {"name": {"type": "string"}, "unit_or_currency": {"type": "string"}, "source": {"type": "string"}, "constraints": {"type": "string"}}}},
    "preconditions": {"type": "array", "items": {"type": "object", "required": ["condition", "otherwise"], "properties": {"condition": {"type": "string"}, "otherwise": {"type": "string"}}}},
    "procedure": {"type": "array", "items": {"type": "string"}},
    "formula": {"type": "string"},
    "rounding": {"type": "object", "required": ["what", "precision", "method", "step"], "properties": {"what": {"type": "string"}, "precision": {"type": "string"}, "method": {"type": "string"}, "step": {"type": "string"}}},
    "result": {"type": "object", "required": ["name", "unit_or_currency", "stored_or_displayed"], "properties": {"name": {"type": "string"}, "unit_or_currency": {"type": "string"}, "stored_or_displayed": {"type": "string"}}},
    "edge_cases": {"type": "array", "items": {"type": "object", "required": ["case", "outcome"], "properties": {"case": {"type": "string"}, "outcome": {"type": "string"}}}},
    "worked_examples": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["inputs", "expected_outputs"], "properties": {"description": {"type": "string"}, "inputs": {"type": "object"}, "expected_outputs": {"type": "object"}, "narrative": {"type": "string"}}}},
    "related_rules": {"type": "array", "items": {"type": "string"}}
  }
}
