    ],
    "definitions": [
     {
      "package": "resource",
      "decorators": [],
      "documentation": "Gets the valid work intervals of the resource following their calendars between ``start`` and ``end``\n\nThis methods handle the eventuality of a resource having multiple resource calendars, see _get_calendars_validity_within_period method\nfor further explanation.\n\nFor flexible calendars and fully flexible resources: -> return the whole interval",
      "size_in_lines": 35,
