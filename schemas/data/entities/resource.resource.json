    "name": "_adjust_to_calendar",
    "kind": "internal_rule",
    "arguments": [
     "self",
     "start",
     "end",
     "compute_leaves"
    ],
    "definitions": [
     {
      "package": "resource",
      "decorators": [],
      "documentation": "Adjust the given start and end datetimes to the closest effective hours encoded\nin the resource calendar. Only attendances in the same day as `start` and `end` are\nconsidered (respectively). If no attendance is found during that day, the closest hour\nis None.\ne.g. simplified example:\n     given two attendances: 8am-1pm and 2pm-5pm, given start=9am and end=6pm\n     resource._adjust_to_calendar(start, end)\n     >>> {resource: (8am, 5pm)}\n:return: Closest matching start and end of working periods for each resource\n:rtype: dict(resource, tuple(datetime | None, datetime | None))",
      "size_in_lines": 36,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "_get_unavailable_intervals",
    "kind": "preparation_rule",
    "arguments": [
     "self",
     "start",
     "end"
    ],
    "definitions": [
     {
      "package": "resource",
      "decorators": [],
      "documentation": "Compute the intervals during which employee is unavailable with hour granularity between start and end\nNote: this method is used in enterprise (forecast and planning)",
      "size_in_lines": 18,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "_get_calendars_validity_within_period",
