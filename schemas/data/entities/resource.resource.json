    ],
    "definitions": [
     {
      "package": "resource",
      "decorators": [],
      "documentation": "Gets a dict of dict with resource's id as first key and resource's calendar as secondary key\nThe value is the validity interval of the calendar for the given resource.\n\nHere the validity interval for each calendar is the whole interval but it's meant to be overriden in further modules\nhandling resource's employee contracts.",
      "size_in_lines": 17,
      "calls_previous_definition": false,
      "validation_messages": []
     },
     {
      "package": "hr",
