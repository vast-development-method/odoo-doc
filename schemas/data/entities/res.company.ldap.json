     {
      "package": "auth_ldap",
      "decorators": [],
      "documentation": "Authenticate a user against the specified LDAP server.\n\nIn order to prevent an unintended 'unauthenticated authentication',\nwhich is an anonymous bind with a valid dn and a blank password,\ncheck for empty passwords explicitely (:rfc:`4513#section-6.3.1`)\n:param dict conf: LDAP configuration\n:param login: username\n:param password: Password for the LDAP user\n:return: LDAP entry of authenticated user or False\n:rtype: dictionary of attributes",
      "size_in_lines": 30,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "_query",
    "kind": "internal_rule",
    "arguments": [
     "self",
     "conf",
     "filter",
     "retrieve_attributes"
    ],
    "definitions": [
     {
      "package": "auth_ldap",
      "decorators": [],
      "documentation": "Query an LDAP server with the filter argument and scope subtree.\n\nAllow for all authentication methods of the simple authentication\nmethod:\n\n- authenticated bind (non-empty binddn + valid password)\n- anonymous bind (empty binddn + empty password)\n- unauthenticated authentication (non-empty binddn + empty password)\n\n.. seealso::\n   :rfc:`4513#section-5.1` - LDAP: Simple Authentication Method.\n\n:param dict conf: LDAP configuration\n:param filter: valid LDAP filter\n:param list retrieve_attributes: LDAP attributes to be retrieved.         If not specified, return all attributes.\n:return: ldap entries\n:rtype: list of tuples (dn, attrs)",
      "size_in_lines": 36,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
