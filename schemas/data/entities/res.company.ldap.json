     "ldap_entry"
    ],
    "definitions": [
     {
      "package": "auth_ldap",
      "decorators": [],
      "documentation": "Compose values for a new resource of model res_users,\nbased upon the retrieved ldap entry and the LDAP settings.\n:param dict conf: LDAP configuration\n:param login: the new user's login\n:param tuple ldap_entry: single LDAP result (dn, attrs)\n:return: parameters for a new resource of model res_users\n:rtype: dict",
      "size_in_lines": 18,
