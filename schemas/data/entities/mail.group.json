   {
    "external_identifier": "mail_group.mail_group_rule_read_all",
    "package": "mail_group",
    "name": "Mail Group: Access only public and joined groups",
    "entity": "mail.group",
    "domain": "[\n            '|',\n            '|',\n            '|',\n                ('moderator_ids', 'in', user.id),\n                ('access_mode', '=', 'public'),\n                '&',\n                    ('access_mode', '=', 'groups'),\n                    ('access_group_id', 'in', user.all_group_ids.ids),\n                '&',\n                    ('access_mode', '=', 'members'),\n                    ('member_partner_ids', 'in', [user.partner_id.id]),\n            ]",
    "groups": "[(4, ref('base.group_user')), (4, ref('base.group_portal')), (4, ref('base.group_public'))]",
    "global": false,
    "applies_to_read": "True",
    "applies_to_write": "False",
    "applies_to_create": "False",
    "applies_to_delete": "False"
   },
   {
    "external_identifier": "mail_group.mail_group_rule_write_all",
    "package": "mail_group",
    "name": "Mail Group: Moderator have write access on their group",
    "entity": "mail.group",
    "domain": "[('moderator_ids', 'in', user.id)]",
    "groups": "[(4, ref('base.group_user'))]",
    "global": false,
    "applies_to_read": "False",
    "applies_to_write": "True",
    "applies_to_create": "False",
    "applies_to_delete": "True"
   },
