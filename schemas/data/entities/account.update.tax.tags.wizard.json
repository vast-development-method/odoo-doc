    ],
    "definitions": [
     {
      "package": "account_update_tax_tags",
      "decorators": [],
      "documentation": "Update Journal Items' tax grids to match current taxes' configuration.\nThe next query work in 3 steps.\n1) Get a duo: (aml_id, tag_id or NULL) for each aml involved with the tax.\n    This first step is achieved in the 3 first table: base line, tax line, fusion.\n    a) As the base line and tax line aren't linked to tax in the same way, we need to gather them separately.\n    The base line get its repartition line by going through the tax.\n    b) The tax lines already have their repartition line linked.\n2) Delete the previous relation aml - tag for each aml appearing in the previous queries.\n3) Insert the new relation aml - tag.\n4) Gather the ids of impacted amls into an array and return it.\n:param: int company_id id of company\n:return: list of impacted account.move.line ids",
      "size_in_lines": 136,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
