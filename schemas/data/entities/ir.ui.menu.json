   {
    "name": "load_web_menus",
    "kind": "operation",
    "arguments": [
     "self",
     "debug"
    ],
    "definitions": [
     {
      "package": "web",
      "decorators": [],
      "documentation": "Loads all menu items (all applications and their sub-menus) and\nprocesses them to be used by the webclient. Mainly, it associates with\neach application (top level menu) the action of its first child menu\nthat is associated with an action (recursively), i.e. with the action\nto execute when the opening the app.\n\n:return: the menus (including the images in Base64)",
      "size_in_lines": 76,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "_get_best_backend_root_menu_id_for_model",
    "kind": "preparation_rule",
    "arguments": [
     "self",
     "res_model"
    ],
    "definitions": [
     {
      "package": "mail",
      "decorators": [
       {
        "name": "api.model",
        "arguments": [],
        "options": {}
       }
      ],
      "documentation": "Get the best menu root id for the given res_model and the access\nrights of the user.\n\nWhen a link to a model was sent to a user it was targeting a page without\nmenu, so it was hard for the user to act on it.\nThe goal of this method is to find the best suited menu to display on a\npage of a given model.\n\nTechnically, the method tries to find a menu root which has a sub menu\nvisible to the user that has an action linked to the given model.\nIf there is more than one possibility, it chooses the preferred one based\non the following preference function that determine the sub-menu from which\nthe root menu is extracted:\n- favor the sub-menu linked to an action having a path as it probably indicates\na \"major\" action\n- then favor the sub-menu with the smallest menu id as it probably indicates\nthat it belongs to the main module of the model and not a sub-one.\n\n:param str res_model: the model name for which we want to find the best\n    menu root id\n:return: the best menu root id or None if not found\n:rtype: int",
      "size_in_lines": 51,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   }
