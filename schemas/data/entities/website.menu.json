   {
    "name": "_is_active",
    "kind": "internal_rule",
    "arguments": [
     "self"
    ],
    "definitions": [
     {
      "package": "website",
      "decorators": [],
      "documentation": "To be considered active, a menu should either:\n\n- have its URL matching the request's URL and have no children\n- or have a children menu URL matching the request's URL\n\nMatching an URL means, either:\n\n- be equal, eg `/contact/on-site` vs `/contact/on-site`\n- be equal after unslug, eg `/shop/1` and `/shop/my-super-product-1`\n\nNote that saving a menu URL with an anchor or a query string is\nconsidered a corner case, and the following applies:\n\n- anchor/fragment are ignored during the comparison (it would be\n  impossible to compare anyway as the client is not sending the anchor\n  to the server as per RFC)\n- query string parameters should be the same to be considered equal, as\n  those could drasticaly alter a page result",
      "size_in_lines": 54,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
