   {
    "name": "_update_product_template_attribute_values",
    "kind": "internal_rule",
    "arguments": [
     "self"
    ],
    "definitions": [
     {
      "package": "product",
      "decorators": [],
      "documentation": "Create or unlink `product.template.attribute.value` for each line in\n`self` based on `value_ids`.\n\nThe goal is to delete all values that are not in `value_ids`, to\nactivate those in `value_ids` that are currently archived, and to create\nthose in `value_ids` that didn't exist.\n\nThis is a trick for the form view and for performance in general,\nbecause we don't want to generate in advance all possible values for all\ntemplates, but only those that will be selected.",
      "size_in_lines": 62,
      "calls_previous_definition": false,
      "validation_messages": []
     }
