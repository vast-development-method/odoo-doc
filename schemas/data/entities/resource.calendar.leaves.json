    "name": "_work_time_per_day",
    "kind": "internal_rule",
    "arguments": [
     "self",
     "resource_calendars"
    ],
    "definitions": [
     {
      "package": "project_timesheet_holidays",
      "decorators": [],
      "documentation": "Get work time per day based on the calendar and its attendances\n\n1) Gets all calendars with their characteristics (i.e.\n    (a) the leaves in it,\n    (b) the resources which have a leave,\n    (c) the oldest and\n    (d) the latest leave dates\n   ) for leaves in self (first for calendar's leaves, then for company's global leaves)\n2) Search the attendances based on the characteristics retrieved for each calendar.\n    The attendances found are the ones between the date_from of the oldest leave\n    and the date_to of the most recent leave.\n3) Create a dict as result of this method containing:\n    {\n        leave: {\n                max(date_start of work hours, date_start of the leave):\n                    the duration in days of the work including the leave\n        }\n    }",
      "size_in_lines": 92,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
