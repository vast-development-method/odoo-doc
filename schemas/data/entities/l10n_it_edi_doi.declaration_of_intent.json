    "definitions": [
     {
      "package": "l10n_it_edi_doi",
      "decorators": [],
      "documentation": "Check whether all declarations of intent in self are valid for the specified `company`, `partner`, `date` and `currency'.\nThe checks for `date` and state of the declaration (except draft) are not considered blocking in case `invoiced_amount` is not positive.\nAll other checks are considered blocking (prevent posting).\nIncludes all checks from `_get_validity_errors`.\nThe checks are different for invoices and sales orders (toggled via kwarg `sales_order`).\nI.e. we do not care about the date for sales orders.\nReturn all errors as a list of strings.",
      "size_in_lines": 22,
      "calls_previous_definition": false,
      "validation_messages": []
     }
