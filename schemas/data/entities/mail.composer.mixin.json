    "definitions": [
     {
      "package": "mail",
      "decorators": [],
      "documentation": "Given some record ids, return the lang for each record based on\nlang field of template or through specific context-based key.\nThis method enters sudo mode to allow qweb rendering (which\nis otherwise reserved for the 'mail template editor' group')\nif we consider it safe. Safe means content comes from the template\nwhich is a validated master data. As a summary the heuristic is :\n\n  * if no template, do not bypass the check;\n  * if record lang and template lang are the same, bypass the check;",
      "size_in_lines": 26,
      "calls_previous_definition": true,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "_render_field",
    "kind": "internal_rule",
    "arguments": [
     "self",
     "field",
     "res_ids",
     "*args",
     "**kwargs"
    ],
    "definitions": [
     {
      "package": "mail",
      "decorators": [],
      "documentation": "Render the given field on the given records. This method enters\nsudo mode to allow qweb rendering (which is otherwise reserved for\nthe 'mail template editor' group') if we consider it safe. Safe\nmeans content comes from the template which is a validated master\ndata. As a summary the heuristic is :\n\n  * if no template, do not bypass the check;\n  * if current user is a template editor, do not bypass the check;\n  * if record value and template value are the same (or equals the\n    sanitized value in case of an HTML field), bypass the check;\n  * for body: if current user cannot edit it, force template value back\n    then bypass the check;\n\nAlso provide support to fetch translations on the remote template.\nIndeed translations are often done on the master template, not on the\nspecific composer itself. In that case we need to work on template\nvalue when it has not been modified in the composer. ",
      "size_in_lines": 68,
      "calls_previous_definition": true,
      "validation_messages": []
     }
    ]
   }
