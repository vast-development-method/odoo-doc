   {
    "name": "_expire_individual_skills",
    "kind": "internal_rule",
    "arguments": [
     "self"
    ],
    "definitions": [
     {
      "package": "hr_skills",
      "decorators": [],
      "documentation": "This function archive all individual skill in self.\nIf the individual skill is not expired (valid_to < today) then valid_to will be set to yesterday if\nit's possible (not break a constraint)\nElse the individual skill is delete\n\nExample:\nAn individual already have the skill English A2 (added one month ago) and we want to delete it\noutput: [[1, id('English A2'), {'valid_to': yesterday}]]\n@return {List[COMMANDS]} List of WRITE, UNLINK commands",
      "size_in_lines": 38,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "_create_individual_skills",
    "kind": "internal_rule",
    "arguments": [
     "self",
     "vals_list"
    ],
    "definitions": [
     {
      "package": "hr_skills",
      "decorators": [],
      "documentation": "This function transform CREATE commands into CREATE, WRITE and UNLINK commands in order to keep the\nlogs and to follow the constraints\n\nExample:\nAn individual already have the skill English A2 (added one month ago) and we want to add the skill English B1\nThis method will transform:\n{linked_field: id, skill_id: id('English'), skill_level_id: id('B1') skill_type_id: id('Languages')}\ninto\n[\n    [1, id('English A2'), {'valid_to': yesterday}],\n    [0, 0, {\n        linked_field: id,\n        skill_id: id('English'),\n        skill_level_id: id('B1'),\n        skill_type_id: id('Languages')}\n    ]\n]\n@param {List[vals]} vals_list: list of right leaf of CREATE commands\n@return {List[COMMANDS]} List of CREATE, WRITE, UNLINK commands",
      "size_in_lines": 120,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "_write_individual_skills",
    "kind": "internal_rule",
    "arguments": [
     "self",
     "commands"
    ],
    "definitions": [
     {
      "package": "hr_skills",
      "decorators": [],
      "documentation": "Transform a list of write commands into a list of create, write and unlink commands according to the logic of\nhow skills should behave. The relevant logic is as follows:\n\n* If \"skill_type_id\", \"skill_id\", \"skill_level_id\", self._linked_field_name() are not in vals, this method will\n    behave like any standard write method.\n* Otherwise, the current record is archived, by changing valid_to to yesterday, and a new one is created with\nvalues from vals and self, with vals taking priority.\n\n\n:param commands: list of WRITE commands\n:return: List of CREATE, WRITE, UNLINK commands",
      "size_in_lines": 63,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "_get_transformed_commands",
    "kind": "preparation_rule",
    "arguments": [
     "self",
     "commands",
     "individuals"
    ],
    "definitions": [
     {
      "package": "hr_skills",
      "decorators": [],
      "documentation": "Transform a list of ORM commands to fit with the business constraints and preserve the logic of how skills and\ncertifications should behave. The key behaviors are as follows:\n\nSkills:\n1. Only one active skill per `skill_id` is allowed (e.g., one \"English\" skill per linked_field record).\n\nCertifications (`is_certification=True`):\n1. Multiple certifications with the same `skill_id` and `level_id` are allowed if their date ranges differ (e.g.,\n    \"the system Certified (2024-01-01 → 2024-12-31)\" and \"the system Certified (2024-06-01 → 2025-05-31)\" can coexist.)\n\nShared Rules:\n- Updates always create new records (archiving old ones) rather than in-place writes.\n- No two records can have all their fields identical.\n- A skill/certification is active if `valid_to` is unset or in the future.\n- A skill/certification that is not active is considered archived.\n- A skill/certification is only deleted if valid_from is from the past 24 hours or it is expired.\n\n:param commands: list of CREATE, WRITE, and UNLINK commands\n:param individuals: a recordset of linked_field's model\n:return: List of CREATE, WRITE, and UNLINK commands",
      "size_in_lines": 57,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   }
