   {
    "name": "_update_subscription_from_email",
    "kind": "internal_rule",
    "arguments": [
     "self",
     "email",
     "opt_out",
     "force_message"
    ],
    "definitions": [
     {
      "package": "mass_mailing",
      "decorators": [],
      "documentation": "When opting-out: we have to switch opted-in subscriptions. We don't\nneed to create subscription for other lists as opt-out = not being a\nmember.\n\nWhen opting-in: we have to switch opted-out subscriptions and create\nsubscription for other mailing lists id they are public. Indeed a\ncontact is opted-in when being subscribed in a mailing list.\n\n:param str email: email address that should opt-in or opt-out from\n  mailing lists;\n:param boolean opt_out: if True, opt-out from lists given by self if\n  'email' is member of it. If False, opt-in in lists givben by self\n  and create membership if not already member;\n:param str force_message: if given, post a note using that body on\n  contact instead of generated update message. Give False to entirely\n  skip the note step;",
      "size_in_lines": 78,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
