    "definitions": [
     {
      "package": "mass_mailing",
      "decorators": [],
      "documentation": "Returns fields and SQL query select path in a dictionnary.\nThis is done to be easily overridable in subsequent modules.\n\n- mailing_list_id             id of the associated mailing.list\n- contact_count:              all contacts\n- contact_count_email:        all valid emails\n- contact_count_opt_out:      all opted-out contacts\n- contact_count_blacklisted:  all blacklisted contacts ",
      "size_in_lines": 26,
      "calls_previous_definition": false,
      "validation_messages": []
     },
     {
      "package": "mass_mailing_sms",
