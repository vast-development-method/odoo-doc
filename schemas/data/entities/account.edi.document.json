   {
    "name": "_filter_edi_attachments_for_mailing",
    "kind": "internal_rule",
    "arguments": [
     "self"
    ],
    "definitions": [
     {
      "package": "account_edi",
      "decorators": [],
      "documentation": "Will either return the information about the attachment of the edi document for adding the attachment in the\nmail, or the attachment id to be linked to the 'send & print' wizard.\nCan be overridden where e.g. a zip-file needs to be sent with the individual files instead of the entire zip\nIMPORTANT:\n* If the attachment's id is returned, no new attachment will be created, the existing one on the move is linked\nto the wizard (see computed attachment_ids field in mail.compose.message).\n* If the attachment's content is returned, a new one is created and linked to the wizard. Thus, when sending\nthe mail (clicking on 'send & print' in the wizard), a new attachment is added to the move (see\n_action_send_mail in mail.compose.message).\n:param document: an edi document\n:return: dict {\n    'attachments': tuple with the name and base64 content of the attachment}\n    'attachment_ids': list containing the id of the attachment\n}",
      "size_in_lines": 29,
      "calls_previous_definition": false,
