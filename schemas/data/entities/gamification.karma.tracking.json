     {
      "package": "gamification",
      "decorators": [],
      "documentation": "Consolidate the karma trackings.\n\nThe consolidation keeps, for each user, the oldest \"old_value\" and the most recent\n\"new_value\", creates a new karma tracking with those values and removes all karma\ntrackings between those dates. The origin / reason is changed on the consolidated\nrecords, so this information is lost in the process.",
      "size_in_lines": 64,
