   {
    "name": "_get_compatible_payment_methods",
    "kind": "preparation_rule",
    "arguments": [
     "self",
     "provider_ids",
     "partner_id",
     "currency_id",
     "force_tokenization",
     "is_express_checkout",
     "report",
     "**kwargs"
    ],
    "definitions": [
     {
      "package": "payment",
      "decorators": [],
      "documentation": "Search and return the payment methods matching the compatibility criteria.\n\nThe compatibility criteria are that payment methods must: be supported by at least one of\nthe providers; support the country of the partner if it exists; be primary payment methods\n(not a brand). If provided, the optional keyword arguments further refine the criteria.\n\n:param list provider_ids: The list of providers by which the payment methods must be at\n                          least partially supported to be considered compatible, as a list\n                          of `payment.provider` ids.\n:param int partner_id: The partner making the payment, as a `res.partner` id.\n:param int currency_id: The payment currency, if known beforehand, as a `res.currency` id.\n:param bool force_tokenization: Whether only payment methods supporting tokenization can be\n                                matched.\n:param bool is_express_checkout: Whether the payment is made through express checkout.\n:param dict report: The report in which each provider's availability status and reason must\n                    be logged.\n:param dict kwargs: Optional data. This parameter is not used here.\n:return: The compatible payment methods.\n:rtype: payment.method",
      "size_in_lines": 96,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "_get_from_code",
    "kind": "preparation_rule",
    "arguments": [
     "self",
     "code",
     "mapping"
    ],
    "definitions": [
     {
      "package": "payment",
      "decorators": [],
      "documentation": "Get the payment method corresponding to the given provider-specific code.\n\nIf a mapping is given, the search uses the generic payment method code that corresponds to\nthe given provider-specific code.\n\n:param str code: The provider-specific code of the payment method to get.\n:param dict mapping: A non-exhaustive mapping of generic payment method codes to\n                     provider-specific codes.\n:return: The corresponding payment method, if any.\n:rtype: payment.method",
      "size_in_lines": 15,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
