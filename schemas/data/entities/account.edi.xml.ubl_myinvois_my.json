   {
    "name": "_l10n_my_edi_get_refund_details",
    "kind": "internal_rule",
    "arguments": [
     "self",
     "invoice"
    ],
    "definitions": [
     {
      "package": "l10n_my_edi",
      "decorators": [
       {
        "name": "api.model",
        "arguments": [],
        "options": {}
       }
      ],
      "documentation": "Helper which returns the refunded document in case of out_refund/in_refund.\nIn some cases, such as PoS, we could need a different logic than from the regular flow.\n:param invoice: The credit note for which we want to get the refunded document.\n:return: A tuple, where the first parameter indicates if this credit note is a refund and the second the credited/refunded document.",
      "size_in_lines": 17,
      "calls_previous_definition": false,
      "validation_messages": []
     },
     {
      "package": "l10n_my_edi_pos",
      "decorators": [
       {
        "name": "api.model",
        "arguments": [],
        "options": {}
       }
      ],
      "documentation": "Override in order to get the original document from the PoS order in case of refund of a\nPoS consolidated invoice.\n\nNote that by design, we consider that a refund done in a PoS is an actual refund and never a\ncredit note.\n:param invoice: The credit note for which we want to get the refunded document.\n:return: A tuple, where the first parameter indicates if this credit note is a refund and the second the credited/refunded document.",
      "size_in_lines": 16,
      "calls_previous_definition": true,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "_l10n_my_edi_get_prepaid_amount",
    "kind": "internal_rule",
    "arguments": [
     "self",
     "invoice"
    ],
    "definitions": [
     {
      "package": "l10n_my_edi",
      "decorators": [
       {
        "name": "api.model",
        "arguments": [],
        "options": {}
       }
      ],
      "documentation": "Compute the amount of the invoice that was genuinely paid in advance.\n\nLHDN only recognizes a reconciled payment as a deposit/prepayment if it was made strictly before the\ninvoice date; a payment made on or after the invoice date is a regular settlement, not a prepayment.\nAdditionally, LHDN never accepts a PayableAmount of 0, so a 100% advance payment must not be reported\nas a prepayment either: in that case, the full invoice amount is reported as payable instead.\nCredit/debit notes reconciled against the invoice are not prepayments.",
      "size_in_lines": 25,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
