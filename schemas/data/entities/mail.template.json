   {
    "name": "_generate_template_attachments",
    "kind": "internal_rule",
    "arguments": [
     "self",
     "res_ids",
     "render_fields",
     "render_results"
    ],
    "definitions": [
     {
      "package": "mail",
      "decorators": [],
      "documentation": "Render attachments of template 'self', returning values for records\ngiven by 'res_ids'. Note that ``report_template_ids`` returns values for\n'attachments', as we have a list of tuple (report_name, base64 value)\nfor those reports. It is considered as being the job of callers to\ntransform those attachments into valid ``ir.attachment`` records.\n\n:param list res_ids: list of record IDs on which template is rendered;\n:param list render_fields: list of fields to render on template which\n  are specific to attachments, e.g. attachment_ids or report_template_ids;\n:param dict render_results: res_ids-based dictionary of render values.\n  For each res_id, a dict of values based on render_fields is given\n\n:return: updated (or new) render_results;",
      "size_in_lines": 74,
      "calls_previous_definition": false,
      "validation_messages": [
       {
        "kind": "UserError",
        "message": "Unsupported report type %s found.",
        "line": 373
       }
      ]
     }
    ]
   },
   {
    "name": "_generate_template_recipients",
    "kind": "internal_rule",
    "arguments": [
     "self",
     "res_ids",
     "render_fields",
     "allow_suggested",
     "find_or_create_partners",
     "render_results"
    ],
    "definitions": [
     {
      "package": "mail",
      "decorators": [],
      "documentation": "Render recipients of the template 'self', returning values for records\ngiven by 'res_ids'. Default values can be generated instead of the template\nvalues if requested by template (see 'use_default_to' field). Email fields\n('email_cc', 'email_to') are transformed into partners if requested\n(finding or creating partners). 'partner_to' field is transformed into\n'partner_ids' field.\n\nNote: for performance reason, information from records are transferred to\ncreated partners no matter the company. For example, if we have a record of\ncompany A and one of B with the same email and no related partner, a partner\nwill be created with company A or B but populated with information from the 2\nrecords. So some info might be leaked from one company to the other through\nthe partner.\n\n:param list res_ids: list of record IDs on which template is rendered;\n:param list render_fields: list of fields to render on template which\n  are specific to recipients, e.g. email_cc, email_to, partner_to);\n:param boolean allow_suggested: when computing default recipients,\n  include suggested recipients in addition to minimal defaults;\n:param boolean find_or_create_partners: transform emails into partners\n  (calling ``find_or_create`` on partner model);\n:param dict render_results: res_ids-based dictionary of render values.\n  For each res_id, a dict of values based on render_fields is given;\n\n:return: updated (or new) render_results. It holds a 'partner_ids' key\n  holding partners given by ``_message_get_default_recipients`` and/or\n  generated based on 'partner_to'. If ``find_or_create_partners`` is\n  False emails are present, otherwise they are included as partners\n  contained in ``partner_ids``.",
      "size_in_lines": 104,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "_generate_template_scheduled_date",
    "kind": "internal_rule",
    "arguments": [
     "self",
     "res_ids",
     "render_results"
    ],
    "definitions": [
     {
      "package": "mail",
      "decorators": [],
      "documentation": "Render scheduled date based on template 'self'. Specific parsing is\ndone to ensure value matches ORM expected value: UTC but without\ntimezone set in value.\n\n:param list res_ids: list of record IDs on which template is rendered;\n:param dict render_results: res_ids-based dictionary of render values.\n  For each res_id, a dict of values based on render_fields is given;\n\n:return: updated (or new) render_results;",
      "size_in_lines": 21,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
