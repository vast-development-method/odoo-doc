   {
    "name": "_get_asset_paths",
    "kind": "preparation_rule",
    "arguments": [
     "self",
     "bundle",
     "assets_params"
    ],
    "definitions": [
     {
      "package": "base",
      "decorators": [
       {
        "name": "tools.conditional",
        "arguments": [
         {
          "expression": "'xml' not in tools.config['dev_mode']"
         },
         {
          "expression": "tools.ormcache('bundle', 'tuple(sorted(assets_params.items()))', cache='assets')"
         }
        ],
        "options": {}
       }
      ],
      "documentation": "Fetches all asset file paths from a given list of addons matching a\ncertain bundle. The returned list is composed of tuples containing the\nfile path [1], the first addon calling it [0] and the bundle name.\nAsset loading is performed as follows:\n\n1. All 'ir.asset' records matching the given bundle and with a sequence\nstrictly less than 16 are applied.\n\n3. The manifests of the given addons are checked for assets declaration\nfor the given bundle. If any, they are read sequentially and their\noperations are applied to the current list.\n\n4. After all manifests have been parsed, the remaining 'ir.asset'\nrecords matching the bundle are also applied to the current list.\n\n:param bundle: name of the bundle from which to fetch the file paths\n:param assets_params: parameters needed by overrides, mainly website_id\n    see _get_asset_params\n:returns: the list of tuples (path, addon, bundle)",
      "size_in_lines": 31,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "_fill_asset_paths",
    "kind": "internal_rule",
    "arguments": [
     "self",
     "bundle",
     "asset_paths",
     "seen",
     "addons",
     "installed",
     "**assets_params"
    ],
    "definitions": [
     {
      "package": "base",
      "decorators": [],
      "documentation": "Fills the given AssetPaths instance by applying the operations found in\nthe matching bundle of the given addons manifests.\nSee `_get_asset_paths` for more information.\n\n:param bundle: name of the bundle from which to fetch the file paths\n:param addons: list of addon names as strings\n:param asset_paths: the AssetPath object to fill\n:param seen: a list of bundles already checked to avoid circularity\n:param assets_params: Keyword arguments:\n\n    * css: bool: whether or not to include style files\n    * js: bool: whether or not to include script files\n    * xml: bool: whether or not to include template files",
      "size_in_lines": 37,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
