   {
    "name": "_get_week_range_and_first_last_days",
    "kind": "preparation_rule",
    "arguments": [
     "self"
    ],
    "definitions": [
     {
      "package": "mrp",
      "decorators": [],
      "documentation": "We calculate the delta between today and the previous monday,\nthen add it to the delta between monday and the previous first day\nof the week as configured in the language settings.\nWe use the result to calculate the modulo of 7 to make sure that\nwe do not take the previous first day of the week from 2 weeks ago.\n\nE.g. today is Thursday, the first of a week is a Tuesday.\nThe delta between today and Monday is 3 days.\nThe delta between Monday and the previous Tuesday is 6 days.\n(3 + 6) % 7 = 2, so from today, the first day of the current week is 2 days ago.",
      "size_in_lines": 30,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
