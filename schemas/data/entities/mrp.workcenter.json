   {
    "name": "_get_unavailability_intervals",
    "kind": "preparation_rule",
    "arguments": [
     "self",
     "start_datetime",
     "end_datetime"
    ],
    "definitions": [
     {
      "package": "mrp",
      "decorators": [],
      "documentation": "Get the unavailabilities intervals for the workcenters in `self`.\n\nReturn the list of unavailabilities (a tuple of datetimes) indexed\nby workcenter id.\n\n:param start_datetime: filter unavailability with only slots after this start_datetime\n:param end_datetime: filter unavailability with only slots before this end_datetime\n:rtype: dict",
      "size_in_lines": 12,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "_get_first_available_slot",
    "kind": "preparation_rule",
    "arguments": [
     "self",
     "start_datetime",
     "duration",
     "forward",
     "leaves_to_ignore",
     "extra_leaves_slots"
    ],
    "definitions": [
     {
      "package": "mrp",
      "decorators": [],
      "documentation": "Get the first available interval for the workcenter in `self`.\n\nThe available interval is disjoinct with all other workorders planned on this workcenter, but\ncan overlap the time-off of the related calendar (inverse of the working hours).\nReturn the first available interval (start datetime, end datetime) or,\nif there is none before 700 days, a tuple error (False, 'error message').\n\n:param duration: minutes needed to make the workorder (float)\n:param start_datetime: begin the search at this datetime\n:param forward: forward scheduling (search from start_datetime to 700 days after), or backward (from start_datetime to now)\n:param leaves_to_ignore: typically, ignore allocated leave when re-planning a workorder\n:param extra_leaves_slots: extra time slots (start, stop) to consider\n:rtype: tuple",
      "size_in_lines": 70,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
