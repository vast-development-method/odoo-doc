    "definitions": [
     {
      "package": "website",
      "decorators": [],
      "documentation": "Returns the response corresponding to the request.\nThe response may or may not come from the cache.\n\nThe management and logic for this cache are placed directly on the\n`website.page` model, as it is the source of the HTML response for these\nrecords. This approach makes it easy to control caching behavior through\na few new, overridable methods:\n-  `_allow_to_use_cache`\n-  `_allow_cache_insertion`\n-  `_post_process_response_from_cache`\n- `_get_cache_key`\n\nThe cache is an ORM cache from `_get_response_cached` with an added\nmechanism to update its values. After a certain period, the system will\nfetch the true response from `_get_response_raw` and update the cached\nvalue. This approach reduces the need for frequent `clear_caches` for\nnon-critical changes while ensuring that the cached data remains\naccurate over time.",
      "size_in_lines": 49,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "_get_response_cached",
    "kind": "preparation_rule",
    "arguments": [
     "self",
     "request"
    ],
    "definitions": [
     {
      "package": "website",
      "decorators": [
       {
        "name": "tools.conditional",
        "arguments": [
         {
          "expression": "'xml' not in tools.config['dev_mode']"
         },
         {
          "expression": "tools.ormcache('self._get_cache_key(request)', cache='templates.cached_values')"
         }
        ],
        "options": {}
       }
      ],
      "documentation": "Returns the response corresponding to the request.\nIf the response exists and `_allow_cache_insertio` return True, this\nresponse is cached.",
      "size_in_lines": 17,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
