    ],
    "definitions": [
     {
      "package": "website",
      "decorators": [],
      "documentation": "Returns the raw response associated with the current request.\nThis method is called by `_get_response_cached`, which handles caching\nthe result. It is also called directly by `_get_response` if\n`_allow_to_use_cache` returns False.",
      "size_in_lines": 35,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "_get_page_info",
