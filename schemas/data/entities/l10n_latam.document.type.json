      "decorators": [],
      "documentation": null,
      "size_in_lines": 19,
      "calls_previous_definition": true,
      "validation_messages": [
       {
        "kind": "UserError",
        "message": "Ecuadorian Document %s must be like 001-001-123456789",
        "line": 35
       }
      ]
     },
     {
      "package": "l10n_uy",
      "decorators": [],
      "documentation": "format and validate the document_number",
      "size_in_lines": 26,
      "calls_previous_definition": true,
