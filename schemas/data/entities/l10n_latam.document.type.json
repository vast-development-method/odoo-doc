    ],
    "definitions": [
     {
      "package": "l10n_latam_invoice_document",
      "decorators": [],
      "documentation": "Method to be inherited by different localizations. The purpose of this method is to allow:\n* making validations on the document_number. If it is wrong it should raise an exception\n* format the document_number against a pattern and return it",
      "size_in_lines": 7,
      "calls_previous_definition": false,
      "validation_messages": []
     },
     {
      "package": "l10n_ar",
      "decorators": [],
      "documentation": "Make validation of Import Dispatch Number\n* making validations on the document_number. If it is wrong it should raise an exception\n* format the document_number against a pattern and return it",
      "size_in_lines": 49,
      "calls_previous_definition": true,
      "validation_messages": [
       {
        "kind": "UserError",
        "message": "%(value)s is not a valid value for %(field)s.\nThe document number must be entered with a dash (-) and a maximum of 5 characters for the first part and 8 for the second. The following are examples of valid numbers:\n* 1-1\n* 0001-00000001\n* 00001-00000001",
        "line": 74
       },
       {
        "kind": "UserError",
        "message": "%(value)s is not a valid value for %(field)s.\nThe number of import Dispatch must be 16 characters.",
        "line": 52
       }
      ]
     },
     {
      "package": "l10n_cl",
      "decorators": [],
      "documentation": "Make validation of Import Dispatch Number\n* making validations on the document_number. If it is wrong it should raise an exception\n* format the document_number against a pattern and return it",
      "size_in_lines": 13,
      "calls_previous_definition": true,
      "validation_messages": []
     },
