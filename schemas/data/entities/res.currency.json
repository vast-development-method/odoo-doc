     "use_cta_rates"
    ],
    "definitions": [
     {
      "package": "account",
      "decorators": [],
      "documentation": "Returns a simplified currency table, faster to generate, for cases were all the data to convert are expressed in the same currency,\nto be use in a JOIN. It actually just consists of a few VALUES ; no temporary table is created in this case.\n\nAll the rates in this currency table are equal to 1 (since everything is in the same currency). This is useful so that the queries can\nbe written exactly in the same way, joining the currency table returned by some function, for both mono and multi currency cases.",
      "size_in_lines": 13,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "_create_currency_table",
    "kind": "internal_rule",
    "arguments": [
     "self",
     "companies",
     "date_periods",
     "use_cta_rates"
    ],
    "definitions": [
     {
      "package": "account",
      "decorators": [],
      "documentation": "Creates a temporary table containing the currency rates to be used in order to aggregate amounts belonging to companies\nwith different main currencies in a reporting query.\nThese rates are computed from the res.currrency.rate objects defined for self.env.company.\n\nThe currency table consists of the following columns:\n    - company_id: The id of the company whose amounts can be converted with this rate.\n    - period_key: The key corresponding to the period this rate is valid for. (see params list)\n    - date_from: Only set for rate_type 'historical'. The starting date for this rate.\n    - date_next: Only set for rate_type 'historical'. The date of the next rate. So, the rate applies until one day before date_next.\n    - rate_type: 'historical', 'current' or 'average'\n                    - 'historical' means the rate is to be used to convert operations at the date they were made; they each\n                       directly correspond to the res.currency.rate objects of the active company\n                    - 'current' means this rate is the most recent rate within the period. This rate is unique per (company_id, period_key).\n                    - 'average' means this rate is the average rate for the period. This rate is unique per (company_id, period_key).\n    - rate: The rate to apply, as a decimal factor to apply directly to the value to convert, provided it is expressed in the\n            main currency of the company referred to by company_id.\n\n\n:param companies: The res.company objects to generate rates for.\n:param date_periods: List of tuples in the form (period_key, date_from, date_to), containing each of the periods to generate rates for, where:\n                     - period_key is a unique string identifier used to differentiate the periods\n                     - date_from is the date the period starts at ; it can be None if the period want to consider everything from the beginning\n                     - date_to is the date the periods ends at\n:param use_cta_rates: Boolean parameter, enabling the computation of CTA rates. If True, 'current', 'average' and 'historical' rates will be\n                computed for all companies, for all periods. Else, only 'current' will be computed.",
      "size_in_lines": 67,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
