    "definitions": [
     {
      "package": "stock",
      "decorators": [],
      "documentation": "Because we can transfer a product from a warehouse to another one thanks to a stock move, we need to\ngenerate some fake stock moves before processing all of them. That way, in case of an interwarehouse\ntransfer, we will have an outgoing stock move for the source warehouse and an incoming stock move\nfor the destination one. To do so, we select all relevant SM (incoming, outgoing and interwarehouse),\nthen we duplicate all these SM and edit the values:\n    - product_qty is kept if the SM is not the duplicated one or if the SM is an interwarehouse one\n        otherwise, we set the value to 0 (this allows us to filter it out during the SM processing)\n    - the source warehouse is kept if the SM is not the duplicated one\n    - the dest warehouse is kept if the SM is not the duplicated one and is not an interwarehouse\n        OR the SM is the duplicated one and is an interwarehouse",
      "size_in_lines": 159,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   }
