    "definitions": [
     {
      "package": "sales_team",
      "decorators": [],
      "documentation": "Specific behavior about active. If you change user_id / team_id user\nget warnings in form view and a raise in constraint check. We support\narchive / activation of memberships that toggles other memberships. But\nwe do not support manual creation or update of user_id / team_id. This\neither works, either crashes). Indeed supporting it would lead to complex\ncode with low added value. Users should create or remove members, and\nmaybe archive / activate them. Updating manually memberships by\nmodifying user_id or team_id is advanced and does not benefit from our\nsupport. ",
      "size_in_lines": 17,
      "calls_previous_definition": true,
      "validation_messages": []
     }
