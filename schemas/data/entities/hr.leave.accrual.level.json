   },
   {
    "name": "_valid_postpone_max_days_value",
    "kind": "Constraint",
    "definition": "CHECK(action_with_unused_accruals <> 'all' OR carryover_options <> 'limited' OR COALESCE(postpone_max_days, 0) > 0)",
    "message": "You cannot have a maximum quantity to carryover set to 0.",
    "defined_in_package": "hr_holidays"
   },
   {
    "name": "_valid_accrual_validity_value",
    "kind": "Constraint",
    "definition": "CHECK(accrual_validity IS NOT TRUE OR COALESCE(accrual_validity_count, 0) > 0)",
    "message": "You cannot have an accrual validity time set to 0.",
