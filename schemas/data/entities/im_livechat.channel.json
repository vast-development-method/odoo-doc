   {
    "name": "_get_less_active_operator",
    "kind": "preparation_rule",
    "arguments": [
     "self",
     "operator_statuses",
     "operators"
    ],
    "definitions": [
     {
      "package": "im_livechat",
      "decorators": [],
      "documentation": "Retrieve the most available operator based on the following criteria:\n- Lowest number of active chats.\n- Not in  a call.\n- If an operator is in a call and has two or more active chats, don't\n  give priority over an operator with more conversations who is not in a\n  call.\n\n:param operator_statuses: list of dictionaries containing the operator's\n    id, the number of active chats and a boolean indicating if the\n    operator is in a call. The list is ordered by the number of active\n    chats (ascending) and whether the operator is in a call\n    (descending).\n:param operators: recordset of :class:`ResUsers` operators to choose from.\n:return: the :class:`ResUsers` record for the chosen operator",
      "size_in_lines": 39,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "_get_operator",
    "kind": "preparation_rule",
    "arguments": [
     "self",
     "previous_operator_id",
     "lang",
     "country_id",
     "expertises",
     "users"
    ],
    "definitions": [
     {
      "package": "im_livechat",
      "decorators": [],
      "documentation": "Return an operator for a livechat. Try to return the previous\noperator if available. If not, one of the most available operators be\nreturned.\n\nA livechat is considered 'active' if it has at least one message within\nthe 30 minutes. This method will try to match the given lang, expertises\nand country_id.\n\n(Some annoying conversions have to be made on the fly because this model\nholds 'res.users' as available operators and the discuss_channel model\nstores the partner_id of the randomly selected operator)\n\n:param previous_operator_id: partner id of the previous operator with\n    whom the visitor was chatting.\n:param lang: code of the preferred lang of the visitor.\n:param country_id: id of the country of the visitor.\n:param expertises: preferred expertises for filtering operators.\n:param users: recordset of available users to use as candidates instead\n    of the users of the livechat channel.\n:return : user\n:rtype : res.users",
      "size_in_lines": 127,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
