   {
    "name": "_perform_analytic_distribution",
    "kind": "internal_rule",
    "arguments": [
     "self",
     "distribution",
     "amount",
     "unit_amount",
     "lines",
     "obj",
     "additive"
    ],
    "definitions": [
     {
      "package": "stock_account",
      "decorators": [],
      "documentation": "Redistributes the analytic lines to match the given distribution:\n    - For account_ids where lines already exist, the amount and unit_amount of these lines get updated,\n      lines where the updated amount becomes zero get unlinked.\n    - For account_ids where lines don't exist yet, the line values to create them are returned,\n      lines where the amount becomes zero are not included.\n\n:param distribution:    the desired distribution to match the analytic lines to\n:param amount:          the total amount to distribute over the analytic lines\n:param unit_amount:     the total unit amount (will not be distributed)\n:param lines:           the (current) analytic account lines that need to be matched to the new distribution\n:param obj:             the object on which _prepare_analytic_line_values(account_id, amount, unit_amount) will be\n                        called to get the template for the values of new analytic line objects\n:param additive:        if True, the unit_amount and (distributed) amount get added to the existing lines\n\n:returns: a list of dicts containing the values for new analytic lines that need to be created\n:rtype:   dict",
      "size_in_lines": 79,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
