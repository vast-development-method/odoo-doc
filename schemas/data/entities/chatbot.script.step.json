   {
    "name": "_fetch_next_step",
    "kind": "internal_rule",
    "arguments": [
     "self",
     "selected_answer_ids"
    ],
    "definitions": [
     {
      "package": "im_livechat",
      "decorators": [],
      "documentation": "Fetch the next step depending on the user's selected answers.\nIf a step contains multiple triggering answers from the same step the condition between\nthem must be a 'OR'. If is contains multiple triggering answers from different steps the\ncondition between them must be a 'AND'.\n\ne.g:\n\nSTEP 1 : A B\nSTEP 2 : C D\nSTEP 3 : E\nSTEP 4 ONLY IF A B C E\n\nScenario 1 (A C E):\n\nA in (A B) -> OK\nC in (C)   -> OK\nE in (E)   -> OK\n\n-> OK\n\nScenario 2 (B D E):\n\nB in (A B) -> OK\nD in (C)   -> NOK\nE in (E)   -> OK\n\n-> NOK",
      "size_in_lines": 44,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
