    ],
    "definitions": [
     {
      "package": "im_livechat",
      "decorators": [],
      "documentation": "Returns the first preceding step that matches either the triggering answers\nor the possible answers the user can select ",
      "size_in_lines": 19,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
