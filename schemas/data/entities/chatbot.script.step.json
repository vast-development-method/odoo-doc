   {
    "name": "_process_step_create_lead",
    "kind": "background_operation",
    "arguments": [
     "self",
     "discuss_channel"
    ],
    "definitions": [
     {
      "package": "crm_livechat",
      "decorators": [],
      "documentation": "When reaching a 'create_lead' step, we extract the relevant information: visitor's\nemail, phone and conversation history to create a crm.lead.\n\nWe use the email and phone to update the environment partner's information (if not a public\nuser) if they differ from the current values.\n\nThe whole conversation history will be saved into the lead's description for reference.\nThis also allows having a question of type 'free_input_multi' to let the visitor explain\ntheir interest / needs before creating the lead. ",
      "size_in_lines": 24,
      "calls_previous_definition": false,
