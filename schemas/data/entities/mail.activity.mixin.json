    "kind": "internal_rule",
    "arguments": [
     "self",
     "act_type_xmlid",
     "date_deadline",
     "summary",
     "views_or_xmlid",
     "render_context",
     "**act_values"
    ],
    "definitions": [
     {
      "package": "mail",
      "decorators": [],
      "documentation": "Helper method: Schedule an activity on each record of the current record set.\nThis method allow to the same mecanism as `activity_schedule`, but provide\n2 additionnal parameters:\n:param views_or_xmlid: record of ir.ui.view or string representing the xmlid\n    of the qweb template to render\n:type views_or_xmlid: string or recordset\n:param render_context: the values required to render the given qweb template\n:type render_context: dict",
      "size_in_lines": 21,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
