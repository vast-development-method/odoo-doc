     "**kwargs"
    ],
    "definitions": [
     {
      "package": "payment",
      "decorators": [],
      "documentation": "Return the available tokens linked to the given providers and partner.\n\nFor a module to retrieve the available tokens, it must override this method and add\ninformation in the kwargs to define the context of the request.\n\n:param list providers_ids: The ids of the providers available for the transaction.\n:param int partner_id: The id of the partner.\n:param bool is_validation: Whether the transaction is a validation operation.\n:param dict kwargs: Locally unused keywords arguments.\n:return: The available tokens.\n:rtype: payment.token",
      "size_in_lines": 24,
      "calls_previous_definition": false,
      "validation_messages": []
     },
     {
      "package": "website_sale",
      "decorators": [],
      "documentation": "Override of `payment` not to return the tokens in case of express checkout.\n\n:param dict args: Locally unused arguments.\n:param bool is_express_checkout: Whether the payment is made through express checkout.\n:param dict kwargs: Locally unused keywords arguments.\n:return: The available tokens.\n:rtype: payment.token",
      "size_in_lines": 13,
      "calls_previous_definition": true,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "_build_display_name",
    "kind": "internal_rule",
    "arguments": [
     "self",
     "*args",
     "max_length",
     "should_pad",
     "**kwargs"
    ],
    "definitions": [
     {
      "package": "payment",
      "decorators": [],
      "documentation": "Build a token name of the desired maximum length with the format `•••• 1234`.\n\nThe payment details are padded on the left with up to four padding characters. The padding\nis only added if there is enough room for it. If not, it is either reduced or not added at\nall. If there is not enough room for the payment details either, they are trimmed from the\nleft.\n\nFor a module to customize the display name of a token, it must override this method and\nreturn the customized display name.\n\nNote: `self.ensure_one()`\n\n:param list args: The arguments passed by QWeb when calling this method.\n:param int max_length: The desired maximum length of the token name. The default is `34` to\n                       fit the largest IBANs.\n:param bool should_pad: Whether the token should be padded.\n:param dict kwargs: Optional data used in overrides of this method.\n:return: The padded token name.\n:rtype: str",
      "size_in_lines": 38,
      "calls_previous_definition": false,
      "validation_messages": []
     },
     {
      "package": "payment_demo",
      "decorators": [],
      "documentation": "Override of `payment` to build the display name without padding.\n\nNote: self.ensure_one()\n\n:param list args: The arguments passed by QWeb when calling this method.\n:param bool should_pad: Whether the token should be padded or not.\n:param dict kwargs: Optional data.\n:return: The demo token name.\n:rtype: str",
      "size_in_lines": 14,
      "calls_previous_definition": true,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "get_linked_records_info",
    "kind": "operation",
    "arguments": [
     "self"
    ],
    "definitions": [
     {
      "package": "payment",
      "decorators": [],
      "documentation": "Return a list of information about records linked to the current token.\n\nFor a module to implement payments and link documents to a token, it must override this\nmethod and add information about linked document records to the returned list.\n\nThe information must be structured as a dict with the following keys:\n\n- `description`: The description of the record's model (e.g. \"Subscription\").\n- `id`: The id of the record.\n- `name`: The name of the record.\n- `url`: The url to access the record.\n\nNote: `self.ensure_one()`\n\n:return: The list of information about the linked document records.\n:rtype: list",
      "size_in_lines": 20,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "_razorpay_get_limit_exceed_warning",
    "kind": "internal_rule",
    "arguments": [
     "self",
     "amount",
     "currency_id"
    ],
    "definitions": [
     {
      "package": "payment_razorpay",
      "decorators": [],
      "documentation": "Return a warning message when the maximum payment amount is exceeded.\n\n:param float amount: The amount to be paid.\n:param currency_id: The currency of the amount.\n:return: A warning message when the maximum payment amount is exceeded.\n:rtype: str",
      "size_in_lines": 39,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "_stripe_sca_migrate_customer",
    "kind": "internal_rule",
    "arguments": [
     "self"
    ],
    "definitions": [
     {
      "package": "payment_stripe",
      "decorators": [],
      "documentation": "Migrate a token from the old implementation of Stripe to the SCA-compliant one.\n\nIn the old implementation, it was possible to create a Charge by giving only the customer id\nand let Stripe use the default source (= default payment method). Stripe now requires to\nspecify the payment method for each new PaymentIntent. To do so, we fetch the payment method\nassociated to a customer and save its id on the token.\nThis migration happens once per token created with the old implementation.\n\nNote: self.ensure_one()\n\n:return: None",
      "size_in_lines": 33,
      "calls_previous_definition": false,
      "validation_messages": [
       {
        "kind": "ValidationError",
        "message": "Unable to convert payment token to new API.",
        "line": 48
       }
      ]
     }
    ]
   }
