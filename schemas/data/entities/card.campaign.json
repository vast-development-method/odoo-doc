   {
    "name": "_check_access_right_dynamic_template",
    "kind": "validation",
    "arguments": [
     "self"
    ],
    "definitions": [
     {
      "package": "marketing_card",
      "decorators": [],
      "documentation": "`_unrestricted_rendering` being True means we trust the value on model\nwhen rendering. This means once created, rendering is done without restriction.\nBut this attribute triggers a check at create / write / translation update that\ncurrent user is an admin or has full edition rights (group_mail_template_editor).\n\n However here a Marketing Card Manager must be able to edit the fields other\n than the rendering fields. The qweb rendered field `body_html` cannot be\n modified by users other than the `base.group_system` users, as\n- it's a related field to `card.template.body`,\n- store=False\n- the model `card.template` can only be altered by `base.group_system`\n\nHence the security is delegated to the 'card.template' model, hence the\ncheck done by `_check_access_right_dynamic_template` can be bypassed.",
      "size_in_lines": 17,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
