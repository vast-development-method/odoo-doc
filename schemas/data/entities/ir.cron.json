   {
    "name": "_process_job",
    "kind": "background_operation",
    "arguments": [
     "cls",
     "cron_cr",
     "job"
    ],
    "definitions": [
     {
      "package": "base",
      "decorators": [
       {
        "name": "classmethod",
        "arguments": [],
        "options": {}
       }
      ],
      "documentation": "Execute the cron's server action in a dedicated transaction.\n\nIn case the previous process actually timed out, the cron's\nserver action is not executed and the cron is considered\n`'failed'`.\n\nThe server action can use the progress API via the method\n:meth:`_commit_progress` to report how many records are done\nin each batch.\nThose progress notifications are used to determine the job's\n`CompletionStatus` and to determine the next time the cron\nwill be executed:\n\n- `'fully done'`: the cron is rescheduled later, it'll be\n  executed again after its regular time interval or upon a new\n  trigger.\n\n- `'partially done'`: the cron is rescheduled ASAP, it'll be\n  executed again by this or another cron worker once the other\n  ready cron jobs have been executed.\n\n- `'failed'`: the cron is deactivated if it failed too many\n  times over a given time span; otherwise it is rescheduled\n  later.",
      "size_in_lines": 57,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
   {
    "name": "_run_job",
    "kind": "background_operation",
    "arguments": [
     "cls",
     "job"
    ],
    "definitions": [
     {
      "package": "base",
      "decorators": [
       {
        "name": "classmethod",
        "arguments": [],
        "options": {}
       }
      ],
      "documentation": "Execute the job's server action multiple times until it\ncompletes. The completion status is returned.\n\nIt is considered completed when either:\n\n- the server action doesn't use the progress API, or returned\n  and notified that all records has been processed: `'fully done'`;\n\n- the server action returned and notified that there are\n  remaining records to process, but this cron worker ran this\n  server action 10 times already: `'partially done'`;\n\n- the server action was able to commit and notify some work done,\n  but later crashed due to an exception: `'partially done'`;\n\n- the server action failed due to an exception and no progress\n  was notified: `'failed'`.",
      "size_in_lines": 111,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   },
