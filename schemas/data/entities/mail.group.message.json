    "external_identifier": "mail_group.mail_group_message_rule_public",
    "package": "mail_group",
    "name": "Mail Group Message: Only accepted message are accessible",
    "entity": "mail.group.message",
    "domain": "[\n            '&',\n                ('moderation_status', '=', 'accepted'),\n                '|',\n                '|',\n                '|',\n                    ('mail_group_id.moderator_ids', 'in', user.id),\n                    ('mail_group_id.access_mode', '=', 'public'),\n                    '&',\n                        ('mail_group_id.access_mode', '=', 'groups'),\n                        ('mail_group_id.access_group_id', 'in', user.all_group_ids.ids),\n                    '&',\n                        ('mail_group_id.access_mode', '=', 'members'),\n                        ('mail_group_id.member_partner_ids', 'in', [user.partner_id.id]),\n            ]",
    "groups": "[(4, ref('base.group_public')), (4, ref('base.group_portal'))]",
