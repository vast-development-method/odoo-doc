   {
    "name": "_retrieve_fixed_tax",
    "kind": "internal_rule",
    "arguments": [
     "self",
     "company_id",
     "fixed_tax_vals"
    ],
    "definitions": [
     {
      "package": "account_edi_ubl_cii",
