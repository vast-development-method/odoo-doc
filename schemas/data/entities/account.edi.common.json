   {
    "name": "_get_basis_qty",
    "kind": "preparation_rule",
    "arguments": [
     "self",
     "tree",
     "xpath_dict"
    ],
    "definitions": [
     {
      "package": "account_edi_ubl_cii",
      "decorators": [],
      "documentation": "Return the base quantity used to derive the unit price from PriceAmount.\nThe standard UBL/CII divides PriceAmount by BaseQuantity to obtain the unit price upon\nimport.",
      "size_in_lines": 6,
      "calls_previous_definition": false,
