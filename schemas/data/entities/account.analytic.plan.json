   {
    "name": "_calculate_distribution_amount",
    "kind": "internal_rule",
    "arguments": [
     "self",
     "amount",
     "percentage",
     "total_percentage",
     "distribution_on_each_plan"
    ],
    "definitions": [
     {
      "package": "stock_account",
      "decorators": [],
      "documentation": "Ensures that the total amount distributed across all lines always adds up to exactly `amount` per\nplan. We try to correct for compounding rounding errors by assigning the exact outstanding amount when\nwe detect that a line will close out a plan's total percentage. However, since multiple plans can be\nassigned to a line, with different prior distributions, there is the possible edge case that one line\ncloses out two (or more) tallies with different compounding errors. This means there is no one correct\namount that we can assign to a line that will correctly close out both all plans. This is described in\nmore detail in the commit message, under \"concurrent closing line edge case\".",
      "size_in_lines": 20,
      "calls_previous_definition": false,
      "validation_messages": []
     }
    ]
   }
